  "paths": {
    "/v1/payments": {
      "post": {
        "summary": "Ask for a payment",
        "parameters": [
          {
            "name": "X-Terminal-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Terminal-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "amount": {
                    "type": "number"
                  },
                  "currency": {
                    "type": "string"
                  }
                },
                "required": [
                  "amount"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok"
          },
          "400": {
            "description": "bad request"
          },
          "401": {
            "description": "unauthorized"
          },
          "404": {
            "description": "not found"
          },
          "409": {
            "description": "conflict"
          },
          "429": {
            "description": "too many"
          },
          "502": {
            "description": "bank error"
          }
        }
      }
    },
    "/v1/payments/{id}": {
      "get": {
        "summary": "Payment status",
