@* A card as it looks in the list: brand, a masked number, name, expiry and account. The full number
   is never stored, so only the last four digits can be shown. *@
<svg class="card-face @StatusClass" viewBox="0 0 340 214" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="@Label">
    <defs>
        <linearGradient id="cfbg" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#1F2638" />
            <stop offset="0.55" stop-color="#0E121C" />
            <stop offset="1" stop-color="#03060F" />
        </linearGradient>
    </defs>
    <rect x="0.5" y="0.5" width="339" height="213" fill="url(#cfbg)" stroke="#2B3550" />
    <path d="M340 70 C 280 90, 240 150, 250 214 L340 214 Z" fill="#EBEEFA" opacity="0.10" />
    <path d="M340 110 C 300 126, 280 170, 286 214 L340 214 Z" fill="#EBEEFA" opacity="0.07" />
    <text x="24" y="40" fill="#EBEEFA" font-family="Sora, sans-serif" font-size="14" font-weight="600" letter-spacing="5">@BrandName</text>
    <text x="316" y="40" fill="#969EAF" font-family="Sora, sans-serif" font-size="9" letter-spacing="2" text-anchor="end">@Tag</text>
    <rect x="24" y="62" width="40" height="30" fill="#969EAF" opacity="0.9" />
    <path d="M24 77 H64 M44 62 V92 M24 69.5 H36 M24 84.5 H36 M52 69.5 H64 M52 84.5 H64" stroke="#0E121C" stroke-width="1" fill="none" />
    <circle cx="28" cy="129" r="2.6" fill="#F5F7FF" /><circle cx="37" cy="129" r="2.6" fill="#F5F7FF" /><circle cx="46" cy="129" r="2.6" fill="#F5F7FF" /><circle cx="55" cy="129" r="2.6" fill="#F5F7FF" /><circle cx="74" cy="129" r="2.6" fill="#F5F7FF" /><circle cx="83" cy="129" r="2.6" fill="#F5F7FF" /><circle cx="92" cy="129" r="2.6" fill="#F5F7FF" /><circle cx="101" cy="129" r="2.6" fill="#F5F7FF" /><circle cx="120" cy="129" r="2.6" fill="#F5F7FF" /><circle cx="129" cy="129" r="2.6" fill="#F5F7FF" /><circle cx="138" cy="129" r="2.6" fill="#F5F7FF" /><circle cx="147" cy="129" r="2.6" fill="#F5F7FF" />
    <text x="164" y="136" fill="#F5F7FF" font-family="Sora, sans-serif" font-size="20" font-weight="500" letter-spacing="2">@Last4</text>
    <text x="24" y="165" fill="#F5F7FF" font-family="Sora, sans-serif" font-size="11" letter-spacing="1.5">@Shorten(Holder, 22)</text>
    <text x="24" y="188" fill="#969EAF" font-family="Sora, sans-serif" font-size="7" letter-spacing="1.5">VALID THRU</text>
    <text x="84" y="188" fill="#F5F7FF" font-family="Sora, sans-serif" font-size="12" letter-spacing="1">@Expiry</text>
    <text x="316" y="188" fill="#F5F7FF" font-family="Sora, sans-serif" font-size="11" letter-spacing="1" text-anchor="end">@Shorten(AccountName, 20)</text>
</svg>

@code {
    [Parameter, EditorRequired] public string Brand { get; set; } = "";
    [Parameter, EditorRequired] public string Last4 { get; set; } = "";
    [Parameter] public int Month { get; set; }
    [Parameter] public int Year { get; set; }
    [Parameter] public string Holder { get; set; } = "";
    [Parameter] public string AccountName { get; set; } = "";
    [Parameter] public string Status { get; set; } = "Active";

    // Cards Paysys issues show as PAYSYS. A card the user added shows its own brand, or CARD when the network
    // is not one Paysys recognises.
    private bool IsPaysys => Brand == "Paysys";
    private string BrandName => IsPaysys ? "PAYSYS" : CardBrandNames.Display(Brand).ToUpperInvariant();
    private string Tag => IsPaysys ? "DEMO" : "ADDED";
    private string Expiry => Month is >= 1 and <= 12 ? $"{Month:00}/{Year % 100:00}" : "--/--";
    private string Label => $"{BrandName} card ending {Last4}, {AccountName}";
    private string StatusClass => Status switch { "Blocked" => "status-blocked", "Paused" or "Pending" => "status-paused", _ => "" };

    private static string Shorten(string text, int max) =>
        text.Length <= max ? text : text[..(max - 1)] + "…";
}
