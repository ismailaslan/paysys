@inherits LayoutComponentBase
@implements IDisposable
@inject AuthState Auth
@inject NavigationManager Navigation
@if (!Auth.IsAuthenticated && IsAnonymousPage)
{
    <div class="auth-page auth-kind-@AuthKind">
        <div class="auth-brand">PAYSYS</div>
        <div class="auth-form-side">
            <div class="auth-titles"><AuthTitles Kind="@AuthKind" Mode="@AuthMode" /></div>
            <div class="auth-form">@Body</div>
        </div>
    </div>
}
else
{
<div class="page @PageKind">
    <header class="top-row">
        @if (Auth.IsAuthenticated)
        {
            <button class="menu-toggle" id="menu-toggle" type="button" aria-label="Open menu" @onclick="OpenMenu">
                <span></span><span></span>
            </button>
        }
        <a class="top-brand" href="">PAYSYS</a>
        @if (Auth.IsAuthenticated)
        {
            <div class="top-right">
                <span class="top-user" id="signed-in-as">@Auth.Username (@Auth.Role)</span>
                <button class="btn btn-secondary btn-sm" id="sign-out" @onclick="Auth.SignOut">Sign out</button>
            </div>
        }
    </header>

    @if (menuOpen && Auth.IsAuthenticated)
    {
        <div class="menu-overlay" id="menu-overlay">
            <div class="menu-head">
                <button class="menu-toggle menu-close" id="menu-close" type="button" aria-label="Close menu" @onclick="CloseMenu">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4 L20 20 M20 4 L4 20" /></svg>
                </button>
                <span class="top-brand">PAYSYS</span>
            </div>
            <div class="menu-body">
                <NavMenu OnNavigate="CloseMenu" />
            </div>
            <div class="menu-foot">
                <span class="top-user">@Auth.Username (@Auth.Role)</span>
                <button class="btn btn-secondary btn-sm" type="button" @onclick="SignOutFromMenu">Sign out</button>
            </div>
        </div>
    }

    <main>
        <article class="content">
            @if (Auth.IsAuthenticated || IsAnonymousPage)
            {
                @Body
            }
            else
            {
                <p>Redirecting to sign in...</p>
            }
        </article>
    </main>
</div>
}

@code {
    // The page keeps the colour of the sign-in tab the user chose.
    private string PageKind => $"page-{Auth.Theme}";

    private bool menuOpen;

    private void OpenMenu() => menuOpen = true;

    private void CloseMenu() => menuOpen = false;

    private void SignOutFromMenu()
    {
        menuOpen = false;
        Auth.SignOut();
    }

    // The Individual / Merchant / Bank titles live here, outside the page, so they stay put
    // while only the form below them changes.
    private string AuthMode =>
        Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("signup", StringComparison.OrdinalIgnoreCase) ? "signup" : "login";

    private string AuthKind
    {
        get
        {
            var query = new Uri(Navigation.Uri).Query;
            return query.Contains("as=merchant", StringComparison.OrdinalIgnoreCase) ? "merchant"
                : query.Contains("as=bank", StringComparison.OrdinalIgnoreCase) ? "bank"
                : "individual";
        }
    }

    // Pages a signed-out visitor may see: Sign in and Sign up. Every other page redirects.
    private bool IsAnonymousPage
    {
        get
        {
            var path = Navigation.ToBaseRelativePath(Navigation.Uri);
            return path.StartsWith("login", StringComparison.OrdinalIgnoreCase)
                || path.StartsWith("signup", StringComparison.OrdinalIgnoreCase)
                || path.StartsWith("forgot", StringComparison.OrdinalIgnoreCase);
        }
    }

    protected override void OnInitialized()
    {
        Auth.Changed += OnAuthChanged;
    }

    // Runs on every navigation (the Body parameter changes), so a signed-out user
    // is redirected before any page - and its API calls - can render.
    protected override void OnParametersSet()
    {
        RedirectIfSignedOut();
    }

    private void OnAuthChanged()
    {
        _ = InvokeAsync(() =>
        {
            RedirectIfSignedOut();
            StateHasChanged();
        });
    }

    private void RedirectIfSignedOut()
    {
        if (!Auth.IsAuthenticated && !IsAnonymousPage)
            Navigation.NavigateTo("login");
    }

    public void Dispose()
    {
        Auth.Changed -= OnAuthChanged;
    }
}
