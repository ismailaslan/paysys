@inherits LayoutComponentBase
@implements IDisposable
@inject AuthState Auth
@inject NavigationManager Navigation
@if (!Auth.IsAuthenticated && IsAnonymousPage)
{
    <div class="auth-page">
        <div class="auth-art">
            <svg viewBox="0 0 340 520" preserveAspectRatio="xMaxYMax slice" style="position:absolute;inset:0;width:100%;height:100%" aria-hidden="true">
                <line x1="0" y1="90" x2="340" y2="90" stroke="#1B2547" stroke-width="1" />
                <line x1="0" y1="180" x2="340" y2="180" stroke="#1B2547" stroke-width="1" />
                <rect x="110" y="200" width="320" height="320" fill="none" stroke="#1B2547" stroke-width="1.5" />
                <rect x="165" y="255" width="265" height="265" fill="none" stroke="#4C5BF0" stroke-width="1.5" />
                <rect x="225" y="315" width="205" height="205" fill="#1B2547" />
                <rect x="285" y="375" width="145" height="145" fill="#4C5BF0" />
            </svg>
            <div class="auth-brand">PAYSYS</div>
            <div class="auth-tagline">Payments,<br />built clean.</div>
        </div>
        <div class="auth-form-side">
            <div class="auth-titles"><AuthTitles Kind="@AuthKind" Mode="@AuthMode" /></div>
            <div class="auth-form">@Body</div>
        </div>
    </div>
}
else
{
<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            @if (Auth.IsAuthenticated)
            {
                <span class="top-user" id="signed-in-as">@Auth.Username (@Auth.Role)</span>
                <button class="btn btn-secondary btn-sm" id="sign-out" @onclick="Auth.SignOut">Sign out</button>
            }
        </div>

        <article class="content px-4">
            @if (Auth.IsAuthenticated || IsAnonymousPage)
            {
                @Body
            }
            else
            {
                <p>Redirecting to sign in...</p>
            }
        </article>
    </main>
</div>
}

@code {
    // The Individual / Merchant / Bank titles live here, outside the page, so they stay put
    // while only the form below them changes.
    private string AuthMode =>
        Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("signup", StringComparison.OrdinalIgnoreCase) ? "signup" : "login";

    private string AuthKind
    {
        get
        {
            var query = new Uri(Navigation.Uri).Query;
            return query.Contains("as=merchant", StringComparison.OrdinalIgnoreCase) ? "merchant"
                : query.Contains("as=bank", StringComparison.OrdinalIgnoreCase) ? "bank"
                : "individual";
        }
    }

    // Pages a signed-out visitor may see: Sign in and Sign up. Every other page redirects.
    private bool IsAnonymousPage
    {
        get
        {
            var path = Navigation.ToBaseRelativePath(Navigation.Uri);
            return path.StartsWith("login", StringComparison.OrdinalIgnoreCase)
                || path.StartsWith("signup", StringComparison.OrdinalIgnoreCase);
        }
    }

    protected override void OnInitialized()
    {
        Auth.Changed += OnAuthChanged;
    }

    // Runs on every navigation (the Body parameter changes), so a signed-out user
    // is redirected before any page - and its API calls - can render.
    protected override void OnParametersSet()
    {
        RedirectIfSignedOut();
    }

    private void OnAuthChanged()
    {
        _ = InvokeAsync(() =>
        {
            RedirectIfSignedOut();
            StateHasChanged();
        });
    }

    private void RedirectIfSignedOut()
    {
        if (!Auth.IsAuthenticated && !IsAnonymousPage)
            Navigation.NavigateTo("login");
    }

    public void Dispose()
    {
        Auth.Changed -= OnAuthChanged;
    }
}
