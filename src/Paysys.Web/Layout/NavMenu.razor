@implements IDisposable
@inject AuthState Auth

<div class="menu-list" @onclick="() => OnNavigate.InvokeAsync()">
    <nav class="nav flex-column">
        @if (Auth.IsAuthenticated)
        {
            @if (Auth.IsMerchant)
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="collect">
                        <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8 H20 V20 H4 Z M4 8 L6 4 H18 L20 8 M9 13 H15" /></svg> Collect
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="terminal">
                        <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3 H17 V21 H7 Z M10 7 H14 M10 11 H14 M10 15 H14 M10 18 H14" /></svg> Demo terminal
                    </NavLink>
                </div>
            }
            else if (Auth.IsBank)
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="bank">
                        <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 9 L12 4 L21 9 M5 9 V18 M9.5 9 V18 M14.5 9 V18 M19 9 V18 M3 20 H21" /></svg> My bank
                    </NavLink>
                </div>
            }
            else
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11 L12 3 L21 11 M5 10 V21 H19 V10 M10 21 V14 H14 V21" /></svg> Send money
                    </NavLink>
                </div>
            }
            @if (Auth.IsAdmin)
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="banks">
                        <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 9 L12 4 L21 9 M5 9 V18 M9.5 9 V18 M14.5 9 V18 M19 9 V18 M3 20 H21" /></svg> Banks
                    </NavLink>
                </div>
            }
            @if (!Auth.IsBank)
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="accounts">
                        <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7 H21 V19 H3 Z M3 7 L17 4 V7 M16 13 H21 V16 H16 Z" /></svg> Accounts
                    </NavLink>
                </div>
            }
            @if (!Auth.IsMerchant && !Auth.IsBank)
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="cards">
                        <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6 H21 V18 H3 Z M3 10 H21 M6 15 H10" /></svg> Cards
                    </NavLink>
                </div>
            }
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="profile">
                    <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4 21 C4 16.5 8 14 12 14 C16 14 20 16.5 20 21" /></svg> Profile
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="history">
                    <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7 V12 L16 14" /></svg> History
                </NavLink>
            </div>
            @if (Auth.IsAdmin)
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="audit">
                        <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 L20 6 V12 C20 16.5 16.5 20 12 21 C7.5 20 4 16.5 4 12 V6 Z M9 12 L11 14 L15 10" /></svg> Audit
                    </NavLink>
                </div>
            }
            @if (Auth.IsAdmin)
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="platform">
                        <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3" /><circle cx="4" cy="6" r="1.6" /><circle cx="20" cy="6" r="1.6" /><circle cx="4" cy="18" r="1.6" /><circle cx="20" cy="18" r="1.6" /><path d="M5.3 7 L10 10.5 M18.7 7 L14 10.5 M5.3 17 L10 13.5 M18.7 17 L14 13.5" /></svg> Platform
                    </NavLink>
                </div>
            }
        
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="how-it-works">
                    <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 11 V16 M12 8 V8.5" /></svg> How it works
                </NavLink>
            </div>
        }
        else
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="login">
                    <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M10 17 L15 12 L10 7 M15 12 H3 M14 4 H21 V20 H14" /></svg> Sign in
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    [Parameter] public EventCallback OnNavigate { get; set; }

    protected override void OnInitialized()
    {
        Auth.Changed += OnAuthChanged;
    }

    private void OnAuthChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Auth.Changed -= OnAuthChanged;
    }
}
