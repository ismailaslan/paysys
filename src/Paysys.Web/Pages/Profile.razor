@page "/profile"
@using Paysys.Shared.Payments
@using Paysys.Shared.Profile
@inject HttpClient Http
@inject Microsoft.JSInterop.IJSRuntime JS
@inject Paysys.Web.Auth.AuthState Auth
@inject NavigationManager Navigation

<PageTitle>Profile</PageTitle>

<h1>Profile</h1>

@if (Auth.TwoStepSetupRequired)
{
    <div id="mfa-required" class="alert alert-danger">Your account must use two-step sign-in. Set it up below. Nothing else works until you have, and you then sign in again with a code.</div>
}

@if (profile is null)
{
    <p class="list-empty">@(loadError ?? "Loading...")</p>
}
else
{
    <div class="profile-layout">
        <nav class="profile-menu" aria-label="Profile sections">
            @foreach (var (key, label) in Sections)
            {
                <button type="button" class="profile-menu-item @(section == key ? "active" : "")" id="profile-menu-@key" @onclick="() => section = key">@label</button>
            }
        </nav>

        <div class="profile-body">
        @if (section == "account")
        {
        <div class="panel">
            <div class="panel-heading">Your account</div>
            <div class="profile-row"><span class="profile-label">Username</span><span id="profile-username">@profile.Username</span></div>
            <div class="profile-row"><span class="profile-label">Account type</span><span>@RoleName(profile.Role)</span></div>
            <div class="profile-row"><span class="profile-label">Member since</span><span>@profile.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</span></div>
            <div class="profile-row"><span class="profile-label">Payment PIN</span><span>@(profile.HasPin ? "Set" : "Not set yet. You set it when you send money.")</span></div>
        </div>

        }
        else if (section == "contact")
        {
        <div class="panel">
            <div class="panel-heading">Contact details</div>
            <div class="mb-3">
                <label for="email">Email</label>
                <input id="email" type="email" autocomplete="off" @bind="email" class="form-control" />
            </div>
            <div class="mb-3">
                <label for="phone">Phone</label>
                <input id="phone" type="text" inputmode="tel" autocomplete="off" @bind="phone" class="form-control" placeholder="+48 600 100 200" />
            </div>
            <div class="send-hint">Optional. These are not verified and are not used to sign in or to recover your account.</div>
            <button id="save-contact" class="btn btn-primary mt-2" type="button" @onclick="SaveContactAsync" disabled="@busy">Save</button>
            <Notice Message="@contactMessage" Failed="@contactFailed" />
        </div>

        }
        else if (section == "pin")
        {
        <div class="panel">
            <div class="panel-heading">Payment PIN</div>
            @if (profile.HasPin)
            {
                <div class="mb-3">
                    <label for="current-pin">Current PIN</label>
                    <input id="current-pin" type="text" inputmode="numeric" maxlength="6" autocomplete="off" @bind="currentPin" @bind:event="oninput" class="form-control send-pin" />
                </div>
            }
            <div class="mb-3">
                <label for="profile-new-pin">New PIN (6 digits)</label>
                <input id="profile-new-pin" type="text" inputmode="numeric" maxlength="6" autocomplete="off" @bind="newPin" @bind:event="oninput" class="form-control send-pin" />
            </div>
            <div class="mb-3">
                <label for="profile-repeat-pin">Repeat the new PIN</label>
                <input id="profile-repeat-pin" type="text" inputmode="numeric" maxlength="6" autocomplete="off" @bind="repeatPin" @bind:event="oninput" class="form-control send-pin" />
            </div>
            <button id="save-pin" class="btn btn-primary" type="button" @onclick="SavePinAsync" disabled="@busy">@(profile.HasPin ? "Change PIN" : "Set PIN")</button>
            <Notice Message="@pinMessage" Failed="@pinFailed" />
        </div>

        }
        else if (section == "mfa")
        {
        <div class="panel">
            <div class="panel-heading">Two-step sign-in</div>
            @if (mfaRecovery is not null)
            {
                <div class="send-hint">Two-step sign-in is on. Save these recovery codes now. Each works once if you lose your authenticator app, and they are not shown again.</div>
                <pre id="recovery-codes" class="mfa-codes">@string.Join("\n", mfaRecovery)</pre>
                <button id="mfa-codes-done" class="btn btn-secondary" type="button" @onclick="RecoverySaved">I saved them</button>
            }
            else if (profile.MfaEnabled)
            {
                <div class="profile-row"><span class="profile-label">Status</span><span id="mfa-status">On</span></div>
                <div class="send-hint">To turn it off, enter your password and a code from your authenticator app (or a recovery code).</div>
                <div class="mb-3">
                    <label for="mfa-off-password">Password</label>
                    <input id="mfa-off-password" type="password" autocomplete="current-password" @bind="mfaOffPassword" class="form-control" />
                </div>
                <div class="mb-3">
                    <label for="mfa-off-code">Code</label>
                    <input id="mfa-off-code" type="text" inputmode="numeric" autocomplete="off" @bind="mfaOffCode" @bind:event="oninput" class="form-control" />
                </div>
                <button id="mfa-off" class="btn btn-secondary" type="button" @onclick="TurnMfaOffAsync" disabled="@busy">Turn off</button>
            }
            else if (mfaStart is null)
            {
                <div class="send-hint">Add a second step to signing in: a 6-digit code from an authenticator app (Google Authenticator, Microsoft Authenticator, 1Password and others).</div>
                <button id="mfa-start" class="btn btn-primary mt-2" type="button" @onclick="StartMfaAsync" disabled="@busy">Set up</button>
            }
            else
            {
                <div class="send-hint">In your authenticator app choose to add an account and enter this key by hand (time based):</div>
                <pre id="mfa-secret" class="mfa-codes">@mfaStart.Secret</pre>
                <div class="send-hint"><a href="@mfaStart.OtpAuthUri">Open in an authenticator app on this device</a></div>
                <div class="mb-3 mt-2">
                    <label for="mfa-on-code">The 6-digit code the app shows</label>
                    <input id="mfa-on-code" type="text" inputmode="numeric" maxlength="6" autocomplete="off" @bind="mfaOnCode" @bind:event="oninput" class="form-control send-pin" />
                </div>
                <button id="mfa-on" class="btn btn-primary" type="button" @onclick="ConfirmMfaAsync" disabled="@busy">Turn on</button>
            }
            <Notice Message="@mfaMessage" Failed="@mfaFailed" />
        </div>

        }
        else if (section == "data")
        {
        <div class="panel">
            <div class="panel-heading">Your data</div>
            <div class="send-hint">Download everything Paysys holds about you as a file: your details, accounts, cards, payments and activity. Your password, PIN and full card numbers are not in it: they are not stored.</div>
            <button id="download-data" class="btn btn-primary mt-2" type="button" @onclick="DownloadDataAsync" disabled="@busy">Download my data</button>
            <Notice Message="@dataMessage" Failed="@dataFailed" />
        </div>

        <div class="panel">
            <div class="panel-heading">Delete my account</div>
            @if (profile.Role != "user")
            {
                <div class="send-hint">Only an individual account can be deleted here. Ask the operator to close a merchant, bank or admin account.</div>
            }
            else
            {
                <div class="send-hint">This removes your name, contact details, PIN and sign-in, and closes your cards. It cannot be undone. Your accounts must be empty and have no open hold. Payment records stay, without your name, because financial records must be kept.</div>
                <div class="mb-3">
                    <label for="delete-password">Your password</label>
                    <input id="delete-password" type="password" autocomplete="current-password" @bind="deletePassword" class="form-control" />
                </div>
                <label class="send-hint"><input id="delete-confirm" type="checkbox" @bind="deleteConfirmed" /> I understand this cannot be undone</label>
                <div><button id="delete-account" class="btn btn-danger mt-2" type="button" @onclick="DeleteAccountAsync" disabled="@(busy || !deleteConfirmed)">Delete my account</button></div>
                <Notice Message="@deleteMessage" Failed="true" />
            }
        </div>
        }
        else
        {
        <div class="panel">
            <div class="panel-heading">Password</div>
            <div class="mb-3">
                <label for="current-password">Current password</label>
                <input id="current-password" type="password" autocomplete="current-password" @bind="currentPassword" class="form-control" />
            </div>
            <div class="mb-3">
                <label for="new-password">New password</label>
                <input id="new-password" type="password" autocomplete="new-password" @bind="newPassword" class="form-control" />
            </div>
            <div class="mb-3">
                <label for="repeat-password">Repeat the new password</label>
                <input id="repeat-password" type="password" autocomplete="new-password" @bind="repeatPassword" class="form-control" />
            </div>
            <button id="save-password" class="btn btn-primary" type="button" @onclick="SavePasswordAsync" disabled="@busy">Change password</button>
            <Notice Message="@passwordMessage" Failed="@passwordFailed" />
        </div>
        }
        </div>
    </div>
}

@code {
    // The section shown on the right; the menu on the left switches it. Typed values stay when you switch.
    private static readonly (string Key, string Label)[] Sections =
    [
        ("account", "Your account"), ("contact", "Contact details"), ("pin", "Payment PIN"), ("password", "Password"), ("mfa", "Two-step sign-in"), ("data", "Your data"),
    ];
    private string section = "account";

    private ProfileResponse? profile;
    private string? loadError;
    private bool busy;

    private string email = "";
    private string phone = "";
    private string? contactMessage;
    private bool contactFailed;

    private string currentPin = "";
    private string newPin = "";
    private string repeatPin = "";
    private string? pinMessage;
    private bool pinFailed;

    private MfaStartResponse? mfaStart;
    private string[]? mfaRecovery;
    private string mfaOnCode = "";
    private string mfaOffPassword = "";
    private string mfaOffCode = "";
    private string? mfaMessage;
    private bool mfaFailed;

    private string? dataMessage;
    private bool dataFailed;
    private string deletePassword = "";
    private bool deleteConfirmed;
    private string? deleteMessage;

    private string currentPassword = "";
    private string newPassword = "";
    private string repeatPassword = "";
    private string? passwordMessage;
    private bool passwordFailed;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (Auth.TwoStepSetupRequired)
                section = "mfa";

            profile = await Http.GetFromJsonAsync<ProfileResponse>("/api/profile");
            email = profile?.Email ?? "";
            phone = profile?.Phone ?? "";
        }
        catch (HttpRequestException)
        {
            loadError = "Couldn't load your profile. Try again.";
        }
    }

    private static string RoleName(string role) => role switch
    {
        "user" => "Individual",
        "merchant" => "Merchant",
        "bank" => "Bank",
        "admin" => "Administrator",
        _ => role,
    };

    private async Task SaveContactAsync()
    {
        contactMessage = null;
        busy = true;
        try
        {
            var response = await Http.PutAsJsonAsync("/api/profile/contact", new UpdateContactRequest(email, phone));
            contactFailed = !response.IsSuccessStatusCode;
            if (response.IsSuccessStatusCode)
            {
                profile = await response.Content.ReadFromJsonAsync<ProfileResponse>();
                email = profile?.Email ?? "";
                phone = profile?.Phone ?? "";
                contactMessage = "Saved.";
            }
            else
            {
                contactMessage = await ApiErrors.ReadAsync(response);
            }
        }
        finally
        {
            busy = false;
        }
    }

    private async Task SavePinAsync()
    {
        pinMessage = null;
        pinFailed = true;

        if (newPin.Length != 6 || !newPin.All(char.IsAsciiDigit))
        {
            pinMessage = "The PIN must be exactly 6 digits.";
            return;
        }

        if (newPin != repeatPin)
        {
            pinMessage = "The two PINs do not match.";
            return;
        }

        if (profile!.HasPin && currentPin.Length < 4)
        {
            pinMessage = "Enter your current PIN.";
            return;
        }

        busy = true;
        try
        {
            var response = await Http.PostAsJsonAsync("/api/pin", new SetPinRequest(newPin, profile.HasPin ? currentPin : null));
            if (!response.IsSuccessStatusCode)
            {
                pinMessage = await ApiErrors.ReadAsync(response);
                return;
            }

            pinFailed = false;
            pinMessage = profile.HasPin ? "PIN changed." : "PIN set.";
            profile = profile with { HasPin = true };
            currentPin = newPin = repeatPin = "";
        }
        finally
        {
            busy = false;
        }
    }

    // After the recovery codes: someone who had to set two-step sign-in up signs in again, now with a code.
    private void RecoverySaved()
    {
        mfaRecovery = null;
        if (Auth.TwoStepSetupRequired)
        {
            Auth.SignOut();
            Navigation.NavigateTo("login");
        }
    }

    private async Task StartMfaAsync()
    {
        mfaMessage = null;
        busy = true;
        try
        {
            var response = await Http.PostAsync("/api/profile/mfa/start", null);
            if (!response.IsSuccessStatusCode)
            {
                mfaFailed = true;
                mfaMessage = await ApiErrors.ReadAsync(response);
                return;
            }

            mfaStart = await response.Content.ReadFromJsonAsync<MfaStartResponse>();
            mfaOnCode = "";
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ConfirmMfaAsync()
    {
        mfaMessage = null;
        busy = true;
        try
        {
            var response = await Http.PostAsJsonAsync("/api/profile/mfa/confirm", new MfaCodeRequest(mfaOnCode));
            if (!response.IsSuccessStatusCode)
            {
                mfaFailed = true;
                mfaMessage = await ApiErrors.ReadAsync(response);
                return;
            }

            var enabled = await response.Content.ReadFromJsonAsync<MfaEnabledResponse>();
            mfaRecovery = enabled!.RecoveryCodes;
            mfaStart = null;
            mfaOnCode = "";
            profile = profile! with { MfaEnabled = true };
        }
        finally
        {
            busy = false;
        }
    }

    private async Task TurnMfaOffAsync()
    {
        mfaMessage = null;
        mfaFailed = true;
        if (string.IsNullOrEmpty(mfaOffPassword) || string.IsNullOrWhiteSpace(mfaOffCode))
        {
            mfaMessage = "Enter your password and a code.";
            return;
        }

        busy = true;
        try
        {
            var response = await Http.PostAsJsonAsync("/api/profile/mfa/disable", new MfaDisableRequest(mfaOffPassword, mfaOffCode));
            if (!response.IsSuccessStatusCode)
            {
                mfaMessage = await ApiErrors.ReadAsync(response);
                return;
            }

            mfaFailed = false;
            mfaMessage = "Two-step sign-in is off.";
            mfaOffPassword = mfaOffCode = "";
            profile = profile! with { MfaEnabled = false };
        }
        finally
        {
            busy = false;
        }
    }

    private async Task DownloadDataAsync()
    {
        dataMessage = null;
        busy = true;
        try
        {
            var response = await Http.GetAsync("/api/profile/export");
            if (!response.IsSuccessStatusCode)
            {
                dataFailed = true;
                dataMessage = await ApiErrors.ReadAsync(response);
                return;
            }

            await JS.InvokeVoidAsync("paysysDownload", "paysys-my-data.json", await response.Content.ReadAsStringAsync());
            dataFailed = false;
            dataMessage = "Your data was downloaded.";
        }
        finally
        {
            busy = false;
        }
    }

    private async Task DeleteAccountAsync()
    {
        deleteMessage = null;
        if (string.IsNullOrEmpty(deletePassword))
        {
            deleteMessage = "Enter your password.";
            return;
        }

        busy = true;
        try
        {
            var response = await Http.PostAsJsonAsync("/api/profile/delete", new DeleteAccountRequest(deletePassword));
            if (!response.IsSuccessStatusCode)
            {
                deleteMessage = await ApiErrors.ReadAsync(response);
                return;
            }

            deletePassword = "";
            Auth.SignOut();
        }
        finally
        {
            busy = false;
        }
    }

    private async Task SavePasswordAsync()
    {
        passwordMessage = null;
        passwordFailed = true;

        if (string.IsNullOrEmpty(currentPassword))
        {
            passwordMessage = "Enter your current password.";
            return;
        }

        if (newPassword != repeatPassword)
        {
            passwordMessage = "The two new passwords do not match.";
            return;
        }

        busy = true;
        try
        {
            var response = await Http.PostAsJsonAsync("/api/profile/password", new ChangePasswordRequest(currentPassword, newPassword));
            if (!response.IsSuccessStatusCode)
            {
                passwordMessage = await ApiErrors.ReadAsync(response);
                return;
            }

            passwordFailed = false;
            currentPassword = newPassword = repeatPassword = "";

            // Every token issued before the change is now refused by the API, this one included, so the page
            // signs out here and the layout shows the sign-in form: sign in again with the new password.
            Auth.SignOut();
        }
        finally
        {
            busy = false;
        }
    }
}
