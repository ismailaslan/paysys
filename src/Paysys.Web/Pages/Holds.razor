@page "/holds"
@inject HttpClient Http
@inject AuthState Auth

<PageTitle>Holds</PageTitle>

<h1>Holds</h1>

@if (Auth.IsMerchant)
{
    <p class="list-empty">
        A hold is money a payer has reserved for you, for a ride or a hotel where the final price comes later. Take what
        you need (up to the held amount) and the rest goes back to the payer at once, or release it all. A hold nobody
        takes is freed after 7 days.
    </p>
}
else
{
    <p class="list-empty">
        A hold reserves money in your account for someone, without paying it yet. The money stays yours but cannot be spent
        while it is held. They take what they need and the rest is freed, and a hold nobody takes is freed after 7 days.
    </p>
}

@if (loadError is not null)
{
    <div class="alert alert-danger">@loadError</div>
}

@if (actionError is not null)
{
    <div id="hold-error" class="alert alert-danger">@actionError</div>
}

@if (holds is null && loadError is null)
{
    <p class="list-empty">Loading...</p>
}
else if (holds is not null && holds.Length == 0)
{
    <div class="panel">
        <div class="panel-heading">No holds</div>
        <p class="list-empty mb-0">
            @if (Auth.IsMerchant)
            {
                <text>Nothing is held for you. Ask for a hold on the <a href="terminal">demo terminal</a>, or through the gateway.</text>
            }
            else
            {
                <text>You have no holds. Tick "Reserve this amount instead of paying it" on <a href="">Send money</a> to place one.</text>
            }
        </p>
    </div>
}
else if (holds is not null)
{
    <div class="panel">
        @foreach (var hold in holds)
        {
            <div class="history-row hold-row" @key="hold.Id">
                <div>
                    <div class="list-item-title">@hold.CounterpartyName</div>
                    <div class="list-item-subtitle">
                        @(Auth.IsMerchant ? "Up to" : "Reserved") @(Auth.IsMerchant ? hold.DestinationCurrency : hold.Currency)
                        @((Auth.IsMerchant ? hold.DestinationAmount : hold.Amount).ToString("0.00"))
                        &middot; placed @hold.CreatedAt.ToLocalTime().ToString("d MMM yyyy HH:mm")
                        @if (hold.Status == "Held")
                        {
                            <text> &middot; open until @hold.ExpiresAt.ToLocalTime().ToString("d MMM yyyy")</text>
                        }
                    </div>
                    @if (hold.Status == "Captured" && hold.CapturedAmount is { } captured)
                    {
                        <div class="list-item-subtitle">Taken: @hold.DestinationCurrency @captured.ToString("0.00")</div>
                    }
                </div>

                <div>
                    <div class="@StatusClass(hold.Status)" data-hold-status="@hold.Id">@StatusLabel(hold.Status)</div>

                    @if (Auth.IsMerchant && hold.Status == "Held")
                    {
                        <div class="hold-actions mt-2">
                            <input type="number" step="0.01" min="0.01" max="@hold.DestinationAmount.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                   class="form-control" aria-label="Amount to take" disabled="@(busyId == hold.Id)"
                                   value="@CaptureValue(hold)" @onchange="e => SetCapture(hold, e.Value?.ToString())" />
                            <button type="button" class="btn btn-primary" @onclick="() => CaptureAsync(hold)" disabled="@(busyId == hold.Id)">Take</button>
                            <button type="button" class="btn btn-secondary" @onclick="() => ReleaseAsync(hold)" disabled="@(busyId == hold.Id)">Release</button>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    private HoldItemResponse[]? holds;
    private string? loadError;
    private string? actionError;
    private Guid? busyId;
    private readonly Dictionary<Guid, decimal> captureAmounts = new();

    private string ListPath => Auth.IsMerchant ? "/api/merchant/holds" : "/api/holds";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            holds = await Http.GetFromJsonAsync<HoldItemResponse[]>(ListPath) ?? [];
            loadError = null;
        }
        catch (HttpRequestException)
        {
            loadError = "Could not load the holds. Try again in a moment.";
        }
    }

    private decimal CaptureValue(HoldItemResponse hold) =>
        captureAmounts.TryGetValue(hold.Id, out var amount) ? amount : hold.DestinationAmount;

    private void SetCapture(HoldItemResponse hold, string? text)
    {
        if (decimal.TryParse(text, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var amount))
            captureAmounts[hold.Id] = amount;
    }

    private async Task CaptureAsync(HoldItemResponse hold)
    {
        var amount = CaptureValue(hold);
        if (amount <= 0 || amount > hold.DestinationAmount || decimal.Round(amount, 2) != amount)
        {
            actionError = $"Take an amount above 0, with at most 2 decimals, and at most {hold.DestinationAmount:0.00} {hold.DestinationCurrency}.";
            return;
        }

        await ChangeAsync(hold, $"/api/merchant/holds/{hold.Id}/capture", new CaptureHoldRequest(amount));
    }

    private Task ReleaseAsync(HoldItemResponse hold) =>
        ChangeAsync(hold, $"/api/merchant/holds/{hold.Id}/release", null);

    private async Task ChangeAsync(HoldItemResponse hold, string path, CaptureHoldRequest? body)
    {
        actionError = null;
        busyId = hold.Id;
        try
        {
            var response = body is null
                ? await Http.PostAsync(path, null)
                : await Http.PostAsJsonAsync(path, body);
            if (!response.IsSuccessStatusCode)
                actionError = await ApiErrors.ReadAsync(response);

            // Whatever happened, show the hold as it is now (it may have been taken or freed meanwhile).
            await LoadAsync();
        }
        finally
        {
            busyId = null;
        }
    }

    private static string StatusLabel(string status) => status switch
    {
        "Held" => "Held",
        "Captured" => "Taken",
        "Released" => "Released",
        "Expired" => "Expired, freed",
        _ => status,
    };

    private static string StatusClass(string status) => status switch
    {
        "Held" => "status-held",
        "Captured" => "status-done",
        _ => "text-muted",
    };
}
