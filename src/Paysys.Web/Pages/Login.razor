@page "/login"
@using Paysys.Shared.Auth
@inject HttpClient Http
@inject AuthState Auth
@inject NavigationManager Navigation

<PageTitle>Sign in</PageTitle>

<div class="auth-swipe auth-swipe-left auth-frame-@Kind" @key="Kind">
<div class="split-layout">
    <div class="form-panel panel">
        <div class="panel-heading">@(Kind == "merchant" ? "Merchant account" : Kind == "bank" ? "Bank account" : "Individual account")</div>

        @if (mfaChallenge is null)
        {
        <div class="mb-3">
            <label for="username">Username</label>
            <input id="username" type="text" @bind="username" autocomplete="username" class="form-control" />
        </div>

        <div class="mb-3">
            <label for="password">Password</label>
            <input id="password" type="password" @bind="password" autocomplete="current-password" class="form-control"
                   @onkeydown="OnKeyDown" />
        </div>

        <div class="d-flex align-items-center gap-3">
            <button class="btn btn-primary" @onclick="SubmitAsync" disabled="@isSubmitting">
                @(isSubmitting ? "Signing in..." : "Sign in")
            </button>
            <a href="forgot?as=@Kind" class="small">Forgot password?</a>
        </div>

        @if (Kind != "bank")
        {
            <div class="mt-3 small">New here? <a href="signup?as=@Kind">Sign up</a></div>
        }
        }
        else
        {
        <div class="mb-3">
            <label for="mfa-code">Sign-in code</label>
            <input id="mfa-code" type="text" inputmode="numeric" autocomplete="one-time-code" @bind="mfaCode" @bind:event="oninput"
                   class="form-control" @onkeydown="OnMfaKeyDown" />
            <div class="send-hint">Enter the 6-digit code from your authenticator app, or one of your recovery codes.</div>
        </div>

        <div class="d-flex align-items-center gap-3">
            <button id="mfa-verify" class="btn btn-primary" @onclick="SubmitMfaAsync" disabled="@isSubmitting">
                @(isSubmitting ? "Checking..." : "Verify")
            </button>
            <button id="mfa-back" class="btn btn-secondary" type="button" @onclick="BackToPassword">Back</button>
        </div>
        }

        @if (errorMessage is not null)
        {
            <div class="alert alert-danger mt-3">
                @errorMessage
            </div>
        }
    </div>
</div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "as")] public string? As { get; set; }

    private string Kind => As is "merchant" or "bank" ? As : "individual";

    private string username = "";
    private string password = "";
    private string? mfaChallenge;
    private string mfaCode = "";
    private bool isSubmitting;
    private string? errorMessage;

    private record LoginError(string? Message);

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SubmitAsync();
    }

    private async Task OnMfaKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SubmitMfaAsync();
    }

    private void BackToPassword()
    {
        mfaChallenge = null;
        mfaCode = "";
        errorMessage = null;
    }

    private async Task SubmitMfaAsync()
    {
        errorMessage = null;
        isSubmitting = true;
        try
        {
            var response = await Http.PostAsJsonAsync("/api/auth/login/mfa", new MfaLoginRequest(mfaChallenge!, mfaCode));

            if (response.IsSuccessStatusCode)
            {
                var login = await response.Content.ReadFromJsonAsync<LoginResponse>();
                Auth.SignIn(login!, Kind);
                mfaChallenge = null;
                mfaCode = "";
                Navigation.NavigateTo("");
            }
            else
            {
                var body = await response.Content.ReadFromJsonAsync<LoginError>();
                errorMessage = body?.Message ?? $"Sign in failed ({(int)response.StatusCode}).";

                // The sign-in step ran out of time: back to the password.
                if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized && errorMessage.StartsWith("The sign-in step expired"))
                    mfaChallenge = null;
            }
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task SubmitAsync()
    {
        errorMessage = null;
        isSubmitting = true;
        try
        {
            var response = await Http.PostAsJsonAsync("/api/auth/login", new LoginRequest(username, password, Kind));

            // 202: the password was right and a sign-in code is needed too (two-step sign-in is on).
            if (response.StatusCode == System.Net.HttpStatusCode.Accepted)
            {
                var required = await response.Content.ReadFromJsonAsync<MfaRequiredResponse>();
                mfaChallenge = required!.Challenge;
                mfaCode = "";
                password = "";
            }
            else if (response.IsSuccessStatusCode)
            {
                var login = await response.Content.ReadFromJsonAsync<LoginResponse>();
                Auth.SignIn(login!, Kind);
                password = "";
                Navigation.NavigateTo(login!.TwoStepSetupRequired ? "profile" : "");
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                errorMessage = "Invalid username or password.";
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.TooManyRequests)
            {
                // The server's message says how long to wait.
                var body = await response.Content.ReadFromJsonAsync<LoginError>();
                errorMessage = body?.Message ?? "Too many failed sign-in attempts. Try again shortly.";
            }
            else
            {
                errorMessage = $"Sign in failed ({(int)response.StatusCode}).";
            }
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
