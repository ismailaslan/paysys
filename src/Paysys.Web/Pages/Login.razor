@page "/login"
@using Paysys.Shared.Auth
@using Microsoft.AspNetCore.Components.WebAssembly.Hosting
@inject HttpClient Http
@inject AuthState Auth
@inject NavigationManager Navigation
@inject IWebAssemblyHostEnvironment HostEnvironment

<PageTitle>Sign in</PageTitle>

<div class="auth-swipe auth-swipe-left auth-frame-@Kind" @key="Kind">
<div class="split-layout">
    <div class="form-panel panel">
        <div class="panel-heading">@(Kind == "merchant" ? "Merchant account" : Kind == "bank" ? "Bank account" : "Individual account")</div>

        <div class="mb-3">
            <label for="username">Username</label>
            <input id="username" type="text" @bind="username" autocomplete="username" class="form-control" />
        </div>

        <div class="mb-3">
            <label for="password">Password</label>
            <input id="password" type="password" @bind="password" autocomplete="current-password" class="form-control"
                   @onkeydown="OnKeyDown" />
        </div>

        <div class="d-flex align-items-center gap-3">
            <button class="btn btn-primary" @onclick="SubmitAsync" disabled="@isSubmitting">
                @(isSubmitting ? "Signing in..." : "Sign in")
            </button>
            <a href="forgot?as=@Kind" class="small">Forgot password?</a>
        </div>

        @if (Kind != "bank")
        {
            <div class="mt-3 small">New here? <a href="signup?as=@Kind">Sign up</a></div>
        }

        @if (HostEnvironment.IsDevelopment())
        {
            <div class="mt-2 small text-muted">Dev login: admin / password</div>
        }

        @if (errorMessage is not null)
        {
            <div class="alert alert-danger mt-3">
                @errorMessage
            </div>
        }
    </div>
</div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "as")] public string? As { get; set; }

    private string Kind => As is "merchant" or "bank" ? As : "individual";

    private string username = "";
    private string password = "";
    private bool isSubmitting;
    private string? errorMessage;

    private record LoginError(string? Message);

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SubmitAsync();
    }

    private async Task SubmitAsync()
    {
        errorMessage = null;
        isSubmitting = true;
        try
        {
            var response = await Http.PostAsJsonAsync("/api/auth/login", new LoginRequest(username, password, Kind));

            if (response.IsSuccessStatusCode)
            {
                var login = await response.Content.ReadFromJsonAsync<LoginResponse>();
                Auth.SignIn(login!, Kind);
                password = "";
                Navigation.NavigateTo("");
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                errorMessage = "Invalid username or password.";
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.TooManyRequests)
            {
                // The server's message says how long to wait.
                var body = await response.Content.ReadFromJsonAsync<LoginError>();
                errorMessage = body?.Message ?? "Too many failed sign-in attempts. Try again shortly.";
            }
            else
            {
                errorMessage = $"Sign in failed ({(int)response.StatusCode}).";
            }
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
