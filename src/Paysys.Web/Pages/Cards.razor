@page "/cards"
@using System.Text.Json
@using Paysys.Web.Shared
@inject HttpClient Http

<PageTitle>Cards</PageTitle>

<h1>Cards</h1>

<div class="split-layout">
    <div class="list-panel panel">
        <div class="panel-heading">Your cards</div>
        @if (cards is null)
        {
            <p class="list-empty">Loading...</p>
        }
        else if (cards.Length == 0)
        {
            <p class="list-empty">No cards yet. Request a Paysys card or add one you already have.</p>
        }
        else
        {
            <div class="card-list">
                @foreach (var card in cards)
                {
                    <div class="card-entry" @key="card.Id">
                        <CardFace Brand="@card.CardBrand" Last4="@card.LastFourDigits" Month="@card.ExpiryMonth" Year="@card.ExpiryYear"
                                  Holder="@card.CardholderName" AccountName="@card.AccountName" Status="@card.Status" />
                        <div class="card-row">
                            <span class="status-tag @StatusClass(card.Status)">@(card.Status == "Blocked" ? "Blocked by bank" : card.Status == "Pending" ? "Waiting for the bank" : card.Status)</span>
                            <span class="card-actions">
                                @if (card.Status == "Active")
                                {
                                    <button class="btn btn-secondary btn-sm" @onclick='() => ChangeAsync(card, "pause")' disabled="@(busyId == card.Id)">Pause</button>
                                }
                                else if (card.Status == "Paused")
                                {
                                    <button class="btn btn-primary btn-sm" @onclick='() => ChangeAsync(card, "resume")' disabled="@(busyId == card.Id)">Resume</button>
                                }
                                <button class="btn btn-secondary btn-sm" @onclick="() => DeleteAsync(card)" disabled="@(busyId == card.Id || card.Status == "Blocked")">@(confirmDeleteId == card.Id ? "Sure? Delete" : "Delete")</button>
                            </span>
                        </div>
                    </div>
                }
            </div>
            @if (cardError is not null)
            {
                <div class="alert alert-danger mt-3">@cardError</div>
            }
        }
    </div>

    <div class="cards-side">
    <div class="form-panel panel">
        <div class="panel-heading">Request a Paysys card</div>
        <p class="list-empty">A new card for one of your accounts. The number and CVV are shown once.</p>

        @if (issuedCard is not null)
        {
            <svg class="issued-card" viewBox="0 0 340 214" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Paysys card">
                <defs>
                    <linearGradient id="cardbg" x1="0" y1="0" x2="1" y2="1">
                        <stop offset="0" stop-color="#1F2638" />
                        <stop offset="0.55" stop-color="#0E121C" />
                        <stop offset="1" stop-color="#03060F" />
                    </linearGradient>
                </defs>
                <rect x="0.5" y="0.5" width="339" height="213" fill="url(#cardbg)" stroke="#2B3550" />
                <path d="M340 70 C 280 90, 240 150, 250 214 L340 214 Z" fill="#EBEEFA" opacity="0.22" />
                <path d="M340 110 C 300 126, 280 170, 286 214 L340 214 Z" fill="#EBEEFA" opacity="0.18" />
                <text x="24" y="40" fill="#EBEEFA" font-family="Sora, sans-serif" font-size="14" font-weight="600" letter-spacing="5">PAYSYS</text>
                <text x="316" y="40" fill="#969EAF" font-family="Sora, sans-serif" font-size="9" letter-spacing="2" text-anchor="end">DEMO</text>
                <rect x="24" y="62" width="40" height="30" fill="#969EAF" opacity="0.9" />
                <path d="M24 77 H64 M44 62 V92 M24 69.5 H36 M24 84.5 H36 M52 69.5 H64 M52 84.5 H64" stroke="#0E121C" stroke-width="1" fill="none" />
                <g transform="translate(300 77)" fill="none" stroke="#969EAF" stroke-width="1.6" stroke-linecap="round">
                    <path d="M-6 -7 Q-1 0 -6 7" />
                    <path d="M-1 -10 Q6 0 -1 10" />
                    <path d="M4 -13 Q13 0 4 13" />
                </g>
                <text x="24" y="136" fill="#F5F7FF" font-family="Sora, sans-serif" font-size="20" font-weight="500" letter-spacing="2">@FormatCardNumber(issuedCard.CardNumber)</text>
                <text x="24" y="170" fill="#969EAF" font-family="Sora, sans-serif" font-size="7" letter-spacing="1.5">VALID THRU</text>
                <text x="24" y="186" fill="#F5F7FF" font-family="Sora, sans-serif" font-size="13" letter-spacing="1">@issuedCard.ExpiryMonth.ToString("00")/@((issuedCard.ExpiryYear % 100).ToString("00"))</text>
                <text x="120" y="170" fill="#969EAF" font-family="Sora, sans-serif" font-size="7" letter-spacing="1.5">CVV</text>
                <text x="120" y="186" fill="#F5F7FF" font-family="Sora, sans-serif" font-size="13" letter-spacing="1">@issuedCard.Cvv</text>
                <text x="316" y="190" fill="#F5F7FF" font-family="Sora, sans-serif" font-size="12" letter-spacing="1.5" text-anchor="end">@issuedCard.CardholderName</text>
            </svg>

            <div class="alert alert-warning mt-3">
                <p class="mb-2">
                    <strong>Shown once.</strong> The full number and CVV are not stored and will
                    not be displayed again. The card will show as ending @(issuedCard.CardNumber[^4..]).
                </p>
            </div>

            <button class="btn btn-primary" @onclick="ResetIssued">Request another card</button>
        }
        else if (accounts is null)
        {
            <p class="list-empty">Loading...</p>
        }
        else if (accounts.Length == 0)
        {
            <p class="list-empty">You need an account to request a card.</p>
        }
        else
        {
            <div class="mb-3">
                <label for="issueAccount">Account</label>
                <select id="issueAccount" @bind="issueAccountId" class="form-select">
                    @foreach (var account in accounts)
                    {
                        <option @key="account.Id" value="@account.Id">@account.Name (@account.Currency @account.Balance.ToString("0.00"))</option>
                    }
                </select>
            </div>

            <button class="btn btn-primary" @onclick="IssueAsync" disabled="@isIssuing">
                @(isIssuing ? "Requesting..." : "Request card")
            </button>

            @if (issueError is not null)
            {
                <div class="alert alert-danger mt-3">@issueError</div>
            }
        }

    </div>

    <div class="form-panel panel">
        <div class="panel-heading">Add a card you already have</div>
        <p class="list-empty">Your card number is checked and swapped for a token. The number itself is never stored.</p>

        @if (createdToken is not null)
        {
            <div class="alert alert-success">
                <p class="mb-1"><strong>Card added. Waiting for the bank to confirm it.</strong></p>
                <p class="mb-0">
                    @CardBrandNames.Display(createdToken.CardBrand) ending @createdToken.LastFourDigits,
                    expires @createdToken.ExpiryMonth.ToString("00")/@((createdToken.ExpiryYear % 100).ToString("00")).
                    Linked to @createdLinkedTo.
                    It can pay as soon as the bank confirms it.
                </p>
            </div>

            <button class="btn btn-primary" @onclick="ResetForm">Add another card</button>
        }
        else if (accounts is null)
        {
            <p class="list-empty">Loading...</p>
        }
        else if (accounts.Length == 0)
        {
            <p class="list-empty">You need an account to add a card.</p>
        }
        else
        {
            <div class="mb-3">
                <label for="account">Pay from account</label>
                <select id="account" @bind="accountId" class="form-select">
                    @foreach (var account in accounts)
                    {
                        <option @key="account.Id" value="@account.Id">@account.Name (@account.Currency @account.Balance.ToString("0.00"))</option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label for="cardNumber">Card number</label>
                <input id="cardNumber" type="text" inputmode="numeric" autocomplete="off" maxlength="23" placeholder="1234 5678 9012 3456"
                       @bind="CardNumberText" @bind:event="oninput" class="form-control" />
                <div class="form-text">Demo: use a test number, for example 4111 1111 1111 1111 (Visa) or 5555 5555 5555 4444 (Mastercard). Don't enter a real card.</div>
            </div>

            <div class="mb-3">
                <label for="expiryMonth">Expiry</label>
                <div class="expiry-row">
                    <input id="expiryMonth" type="text" inputmode="numeric" autocomplete="off" maxlength="2" placeholder="MM"
                           @bind="expiryMonthText" @bind:event="oninput" class="form-control expiry-input" aria-label="Expiry month" />
                    <span>/</span>
                    <input id="expiryYear" type="text" inputmode="numeric" autocomplete="off" maxlength="2" placeholder="YY"
                           @bind="expiryYearText" @bind:event="oninput" class="form-control expiry-input" aria-label="Expiry year, two digits" />
                    @if (CardTypeHint.Length > 0)
                    {
                        <span class="brand-hint" aria-live="polite">@CardTypeHint</span>
                    }
                </div>
            </div>

            <button class="btn btn-primary" @onclick="SubmitAsync" disabled="@isSubmitting">
                @(isSubmitting ? "Adding..." : "Add card")
            </button>

            @if (errorMessage is not null)
            {
                <div class="alert alert-danger mt-3">
                    @errorMessage
                </div>
            }
        }
    </div>
    </div>
</div>

@code {
    private CardTokenSummaryResponse[]? cards;
    private AccountResponse[]? accounts;
    private string issueAccountId = "";
    private bool isIssuing;
    private string? issueError;
    private IssueCardResponse? issuedCard;
    private string accountId = "";
    private string cardNumber = "";

    // The number is shown in groups as it is typed (4-4-4-4, or 4-6-5 for Amex), up to 19 digits.
    private string CardNumberText
    {
        get => cardNumber;
        set => cardNumber = CardNumberHint.Format(CardNumberHint.Digits(value));
    }

    private string CardTypeHint => CardNumberHint.Describe(CardNumberHint.Digits(cardNumber));
    private string expiryMonthText = "";
    private string expiryYearText = "";
    private string createdLinkedTo = "";
    private bool isSubmitting;
    private string? errorMessage;
    private TokenizeCardResponse? createdToken;
    private Guid? busyId;
    private Guid? confirmDeleteId;
    private string? cardError;

    private static string StatusClass(string status) => status switch
    {
        "Paused" => "paused",
        "Blocked" => "blocked",
        "Pending" => "pending",
        _ => "active",
    };

    private async Task ChangeAsync(CardTokenSummaryResponse card, string action)
    {
        cardError = null;
        confirmDeleteId = null;
        busyId = card.Id;
        try
        {
            var response = await Http.PostAsync($"/api/cards/{card.Id}/{action}", null);
            if (!response.IsSuccessStatusCode)
                cardError = await ApiErrors.ReadAsync(response);
            await LoadCardsAsync();
        }
        finally
        {
            busyId = null;
        }
    }

    // Two taps: the first asks, the second deletes.
    private async Task DeleteAsync(CardTokenSummaryResponse card)
    {
        cardError = null;
        if (confirmDeleteId != card.Id)
        {
            confirmDeleteId = card.Id;
            return;
        }

        confirmDeleteId = null;
        busyId = card.Id;
        try
        {
            var response = await Http.DeleteAsync($"/api/cards/{card.Id}");
            if (!response.IsSuccessStatusCode)
                cardError = await ApiErrors.ReadAsync(response);
            await LoadCardsAsync();
        }
        finally
        {
            busyId = null;
        }
    }


    protected override async Task OnInitializedAsync()
    {
        await LoadCardsAsync();
        accounts = await Http.GetFromJsonAsync<AccountResponse[]>("/api/accounts");
        if (accounts is { Length: > 0 })
        {
            issueAccountId = accounts[0].Id.ToString();
            accountId = accounts[0].Id.ToString();
        }
    }

    private async Task IssueAsync()
    {
        issueError = null;

        if (!Guid.TryParse(issueAccountId, out var parsedAccountId))
        {
            issueError = "Select an account.";
            return;
        }

        isIssuing = true;
        try
        {
            var response = await Http.PostAsJsonAsync("/api/cards/issue", new IssueCardRequest(parsedAccountId));
            if (response.IsSuccessStatusCode)
            {
                issuedCard = await response.Content.ReadFromJsonAsync<IssueCardResponse>();
                await LoadCardsAsync();
            }
            else
            {
                issueError = await ApiErrors.ReadAsync(response);
            }
        }
        finally
        {
            isIssuing = false;
        }
    }

    private void ResetIssued()
    {
        issuedCard = null;
        issueError = null;
    }

    private static string FormatCardNumber(string number) =>
        string.Join(" ", Enumerable.Range(0, (number.Length + 3) / 4).Select(i => number.Substring(i * 4, Math.Min(4, number.Length - i * 4))));

    private async Task LoadCardsAsync()
    {
        cards = await Http.GetFromJsonAsync<CardTokenSummaryResponse[]>("/api/tokenize");
    }

    private async Task SubmitAsync()
    {
        errorMessage = null;

        if (!Guid.TryParse(accountId, out var parsedAccountId))
        {
            errorMessage = "Select an account.";
            return;
        }

        var monthText = expiryMonthText.Trim();
        var yearText = expiryYearText.Trim();
        if (!int.TryParse(monthText, out var month) || month is < 1 or > 12
            || yearText.Length != 2 || !int.TryParse(yearText, out var shortYear))
        {
            errorMessage = "Enter the expiry as MM / YY, for example 09 / 28.";
            return;
        }

        isSubmitting = true;
        try
        {
            var request = new TokenizeCardRequest(parsedAccountId, cardNumber, month, 2000 + shortYear);
            var response = await Http.PostAsJsonAsync("/api/tokenize", request);

            if (response.IsSuccessStatusCode)
            {
                createdToken = await response.Content.ReadFromJsonAsync<TokenizeCardResponse>();

                // The number is not kept in the page once the card is added.
                cardNumber = "";

                var linked = accounts?.FirstOrDefault(a => a.Id == parsedAccountId);
                createdLinkedTo = linked is null ? "your account" : $"{linked.Name} ({linked.Currency} {linked.Balance:0.00})";
                await LoadCardsAsync();
            }
            else
            {
                errorMessage = await ApiErrors.ReadAsync(response);
            }
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void ResetForm()
    {
        createdToken = null;
        accountId = accounts is { Length: > 0 } ? accounts[0].Id.ToString() : "";
        cardNumber = "";
        expiryMonthText = "";
        expiryYearText = "";
        errorMessage = null;
    }

}
