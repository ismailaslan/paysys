@page "/cards"
@using System.Text.Json
@inject HttpClient Http
@inject IJSRuntime JSRuntime

<PageTitle>Cards</PageTitle>

<h1>Cards</h1>

<div class="split-layout">
    <div class="list-panel panel">
        <div class="panel-heading">Existing Cards</div>
        @if (cards is null)
        {
            <p class="list-empty">Loading...</p>
        }
        else if (cards.Length == 0)
        {
            <p class="list-empty">No cards yet.</p>
        }
        else
        {
            <div class="list-items">
                @foreach (var card in cards)
                {
                    <div class="list-item" @key="card.Id">
                        <div class="list-item-title">@card.CardBrand ending @card.LastFourDigits</div>
                        <div class="list-item-subtitle">@card.AccountName</div>
                    </div>
                }
            </div>
        }
    </div>

    <div class="form-panel panel">
        <div class="panel-heading">Tokenize a Card</div>

        @if (createdToken is not null)
        {
            <div class="alert alert-success">
                <p><strong>Card tokenized.</strong></p>
                <p>
                    Id: @createdToken.Id<br />
                    Card: @createdToken.CardBrand ending @createdToken.LastFourDigits<br />
                    Expiry: @createdToken.ExpiryMonth.ToString("00")/@createdToken.ExpiryYear
                </p>
            </div>

            <div class="alert alert-warning">
                <p class="mb-2">
                    <strong>Token</strong> &mdash; shown once, right now. It won't be
                    displayed again anywhere in this app; copy it if you need it (e.g.
                    to paste into the transaction form's "From" field).
                </p>
                <div class="d-flex gap-2">
                    <input type="text" readonly value="@createdToken.Token" class="form-control" onclick="this.select()" />
                    <button class="btn btn-secondary" type="button" @onclick="CopyTokenAsync">@(copyStatus ?? "Copy")</button>
                </div>
            </div>

            <button class="btn btn-primary" @onclick="ResetForm">Tokenize another</button>
        }
        else if (accounts is null)
        {
            <p class="list-empty">Loading...</p>
        }
        else
        {
            <div class="mb-3">
                <label for="account">Account</label>
                <select id="account" @bind="accountId" class="form-select">
                    <option value="">-- select --</option>
                    @foreach (var account in accounts)
                    {
                        <option @key="account.Id" value="@account.Id">@account.Name (@account.AccountType, @account.Currency @account.Balance.ToString("0.00"))</option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label for="cardNumber">Card number</label>
                <input id="cardNumber" type="text" @bind="cardNumber" class="form-control" />
            </div>

            <div class="mb-3">
                <label for="expiryMonth">Expiry month</label>
                <input id="expiryMonth" type="number" min="1" max="12" @bind="expiryMonth" class="form-control" />
            </div>

            <div class="mb-3">
                <label for="expiryYear">Expiry year</label>
                <input id="expiryYear" type="number" @bind="expiryYear" class="form-control" />
            </div>

            <button class="btn btn-primary" @onclick="SubmitAsync" disabled="@isSubmitting">
                @(isSubmitting ? "Submitting..." : "Submit")
            </button>

            @if (errorMessage is not null)
            {
                <div class="alert alert-danger mt-3">
                    @errorMessage
                </div>
            }
        }
    </div>
</div>

@code {
    private CardTokenSummaryResponse[]? cards;
    private AccountResponse[]? accounts;
    private string accountId = "";
    private string cardNumber = "";
    private int expiryMonth;
    private int expiryYear;
    private bool isSubmitting;
    private string? errorMessage;
    private TokenizeCardResponse? createdToken;
    private string? copyStatus;

    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web);

    protected override async Task OnInitializedAsync()
    {
        await LoadCardsAsync();
        accounts = await Http.GetFromJsonAsync<AccountResponse[]>("/api/accounts");
    }

    private async Task LoadCardsAsync()
    {
        cards = await Http.GetFromJsonAsync<CardTokenSummaryResponse[]>("/api/tokenize");
    }

    private async Task SubmitAsync()
    {
        errorMessage = null;

        if (!Guid.TryParse(accountId, out var parsedAccountId))
        {
            errorMessage = "Select an account.";
            return;
        }

        isSubmitting = true;
        try
        {
            var request = new TokenizeCardRequest(parsedAccountId, cardNumber, expiryMonth, expiryYear);
            var response = await Http.PostAsJsonAsync("/api/tokenize", request);

            if (response.IsSuccessStatusCode)
            {
                createdToken = await response.Content.ReadFromJsonAsync<TokenizeCardResponse>();
                await LoadCardsAsync();
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
            {
                var problem = await response.Content.ReadFromJsonAsync<ValidationProblemResponse>(JsonOptions);
                var messages = problem?.Errors?.SelectMany(kvp => kvp.Value) ?? [];
                errorMessage = messages.Any()
                    ? string.Join(" ", messages)
                    : await response.Content.ReadAsStringAsync();
            }
            else
            {
                errorMessage = $"Request failed ({(int)response.StatusCode}): {await response.Content.ReadAsStringAsync()}";
            }
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task CopyTokenAsync()
    {
        if (createdToken is null)
            return;

        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", createdToken.Token);
            copyStatus = "Copied!";
        }
        catch
        {
            copyStatus = "Copy failed - select the text and copy manually";
        }
    }

    private void ResetForm()
    {
        createdToken = null;
        accountId = "";
        cardNumber = "";
        expiryMonth = 0;
        expiryYear = 0;
        errorMessage = null;
        copyStatus = null;
    }

    private record ValidationProblemResponse(Dictionary<string, string[]>? Errors);
}
