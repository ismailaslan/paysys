@page "/"
@inject HttpClient Http

<PageTitle>New Transaction</PageTitle>

<h1>Create a Transaction</h1>

@if (accounts is null)
{
    <p>Loading accounts...</p>
}
else if (accounts.Length == 0)
{
    <p>No accounts found. Create some via POST /api/accounts first.</p>
}
else
{
    <div class="two-col-row">
        <div class="mb-3">
            <label for="sourceCardToken">From (card token)</label>
            <input id="sourceCardToken" type="text" @bind="sourceCardToken" class="form-control" placeholder="tok_..." />
        </div>

        <div class="mb-3">
            <label for="destination">To</label>
            <select id="destination" @bind="destinationAccountId" class="form-select" disabled="@(payee is not null)">
                <option value="">-- select --</option>
                @foreach (var account in accounts)
                {
                    <option @key="account.Id" value="@account.Id">@account.Name (@account.AccountType, @account.Currency @account.Balance.ToString("0.00"))</option>
                }
            </select>
        </div>
    </div>

    <div class="mb-3">
        <label for="payeeCode">Or pay someone by payee code</label>
        <div class="d-flex gap-2">
            <input id="payeeCode" type="text" @bind="payeeCode" @bind:event="oninput" class="form-control" placeholder="PAY-XXXXX-XXXXX"
                   disabled="@(payee is not null)" @onkeydown="OnPayeeKeyDown" />
            @if (payee is null)
            {
                <button id="payee-lookup" class="btn btn-secondary" type="button" @onclick="LookUpPayeeAsync" disabled="@isLookingUp">
                    @(isLookingUp ? "Looking up..." : "Look up")
                </button>
            }
            else
            {
                <button id="payee-clear" class="btn btn-secondary" type="button" @onclick="ClearPayee">Clear</button>
            }
        </div>
        @if (payee is not null)
        {
            <div id="payee-found" class="alert alert-success mt-2">
                Paying <strong>@payee.DisplayName</strong> (@payee.Currency, @payee.BankName)
            </div>
        }
        @if (payeeError is not null)
        {
            <div id="payee-error" class="alert alert-danger mt-2">@payeeError</div>
        }
    </div>

    <div class="amount-panel">
        <div class="amount-panel-label">Amount</div>
        <div class="amount-display">
            <input class="amount-input" type="number" step="0.01" @bind="amount" />
        </div>
        <div class="preview-text text-muted">
            Currency and conversion preview are resolved server-side from the card - not shown before submitting.
        </div>
    </div>

    <button class="btn btn-primary w-100 submit-button" @onclick="SubmitAsync" disabled="@isSubmitting">
        @(isSubmitting ? "Submitting..." : "Submit")
    </button>
}

@if (resultMessage is not null)
{
    <div class="alert @(resultIsSuccess ? "alert-success" : "alert-danger") mt-3">
        @resultMessage
    </div>
}

@code {
    private AccountResponse[]? accounts;
    private string sourceCardToken = "";
    private string destinationAccountId = "";
    private decimal amount;
    private string? resultMessage;
    private bool resultIsSuccess;
    private bool isSubmitting;

    private string payeeCode = "";
    private PayeeResponse? payee;
    private string? payeeError;
    private bool isLookingUp;

    private async Task OnPayeeKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && payee is null)
            await LookUpPayeeAsync();
    }

    private async Task LookUpPayeeAsync()
    {
        payeeError = null;
        isLookingUp = true;
        try
        {
            var response = await Http.GetAsync($"/api/payees/lookup?code={Uri.EscapeDataString(payeeCode)}");

            if (response.IsSuccessStatusCode)
            {
                payee = await response.Content.ReadFromJsonAsync<PayeeResponse>();
                destinationAccountId = payee!.AccountId.ToString();
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                payeeError = "No payee found for that code.";
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
            {
                payeeError = "That doesn't look like a payee code. It should look like PAY-XXXXX-XXXXX.";
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.TooManyRequests)
            {
                payeeError = "Too many lookups that didn't match. Wait a moment and try again.";
            }
            else
            {
                payeeError = $"Lookup failed ({(int)response.StatusCode}).";
            }
        }
        finally
        {
            isLookingUp = false;
        }
    }

    private void ClearPayee()
    {
        payee = null;
        payeeCode = "";
        payeeError = null;
        destinationAccountId = "";
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAccountsAsync();
    }

    private async Task LoadAccountsAsync()
    {
        accounts = await Http.GetFromJsonAsync<AccountResponse[]>("/api/accounts");
    }

    private async Task SubmitAsync()
    {
        resultMessage = null;

        if (string.IsNullOrWhiteSpace(sourceCardToken) || !Guid.TryParse(destinationAccountId, out var destinationId))
        {
            resultIsSuccess = false;
            resultMessage = "Enter a source card token and select a destination account.";
            return;
        }

        // HOOK POINT (not implemented yet): client-side "Are you sure?"
        // confirmation and PIN entry belong here, before the request is sent -
        // return early without submitting if the user cancels or the PIN entry
        // fails client-side checks.

        isSubmitting = true;
        try
        {
            var request = new CreateTransactionRequest(
                sourceCardToken,
                destinationId,
                amount,
                Guid.NewGuid().ToString());

            var response = await Http.PostAsJsonAsync("/api/transactions", request);

            if (response.IsSuccessStatusCode)
            {
                var transaction = await response.Content.ReadFromJsonAsync<TransactionResponse>();
                if (transaction!.Status == "Completed")
                {
                    await LoadAccountsAsync();
                    var updatedSource = accounts!.First(a => a.Id == transaction.SourceAccountId);

                    // The destination is only in the user's own account list if it is theirs (or
                    // they are an admin); someone paid by payee code is not, and their balance is
                    // deliberately not shown.
                    var updatedDestination = accounts!.FirstOrDefault(a => a.Id == destinationId);
                    resultIsSuccess = true;
                    resultMessage = $"Transaction completed. {updatedSource.Name} balance: {updatedSource.Currency} {updatedSource.Balance:0.00}. "
                        + (updatedDestination is not null
                            ? $"{updatedDestination.Name} balance: {updatedDestination.Currency} {updatedDestination.Balance:0.00}."
                            : $"Paid {payee?.DisplayName ?? "the payee"}.");
                    ClearPayee();
                    if (transaction.CardTokenId is not null)
                    {
                        resultMessage += $" Authorized via card ending {transaction.CardTokenLastFourDigits}.";
                    }
                }
                else
                {
                    resultIsSuccess = false;
                    resultMessage = $"Transaction failed: {transaction.FailureReason}";
                }
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                resultIsSuccess = false;
                resultMessage = $"Request failed ({(int)response.StatusCode}): {body}";
            }
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
