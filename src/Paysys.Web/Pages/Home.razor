@page "/"
@inject HttpClient Http

<PageTitle>New Transaction</PageTitle>

<h1>Create a Transaction</h1>

@if (accounts is null)
{
    <p>Loading accounts...</p>
}
else if (accounts.Length == 0)
{
    <p>No accounts found. Create some via POST /api/accounts first.</p>
}
else
{
    <div class="mb-3">
        <label for="source">Source account</label>
        <select id="source" @bind="sourceAccountId" @bind:after="UpdatePreviewAsync" class="form-select">
            <option value="">-- select --</option>
            @foreach (var account in accounts)
            {
                <option @key="account.Id" value="@account.Id">@account.Name (@account.AccountType, @account.Currency @account.Balance.ToString("0.00"))</option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label for="destination">Destination account</label>
        <select id="destination" @bind="destinationAccountId" @bind:after="UpdatePreviewAsync" class="form-select">
            <option value="">-- select --</option>
            @foreach (var account in accounts)
            {
                <option @key="account.Id" value="@account.Id">@account.Name (@account.AccountType, @account.Currency @account.Balance.ToString("0.00"))</option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label for="amount">Amount</label>
        <input id="amount" type="number" step="0.01" @bind="amount" @bind:event="oninput" @bind:after="UpdatePreviewAsync" class="form-control" />
        @if (previewMessage is not null)
        {
            <div class="form-text @(previewIsError ? "text-danger" : "text-muted")">@previewMessage</div>
        }
    </div>

    <div class="mb-3">
        <label for="currency">Currency</label>
        <input id="currency" type="text" value="@currency" readonly class="form-control" />
    </div>

    <div class="mb-3">
        <label for="cardToken">Card token (optional)</label>
        <select id="cardToken" @bind="cardTokenId" class="form-select">
            <option value="">-- none --</option>
            @foreach (var token in cardTokens ?? [])
            {
                <option @key="token.Id" value="@token.Id">@token.CardBrand ending @token.LastFourDigits</option>
            }
        </select>
    </div>

    <button class="btn btn-primary" @onclick="SubmitAsync" disabled="@isSubmitting">
        @(isSubmitting ? "Submitting..." : "Submit")
    </button>
}

@if (resultMessage is not null)
{
    <div class="alert @(resultIsSuccess ? "alert-success" : "alert-danger") mt-3">
        @resultMessage
    </div>
}

@code {
    private AccountResponse[]? accounts;
    private CardTokenSummaryResponse[]? cardTokens;
    private string sourceAccountId = "";
    private string destinationAccountId = "";
    private string cardTokenId = "";
    private decimal amount;
    private string? resultMessage;
    private bool resultIsSuccess;
    private bool isSubmitting;

    private string? previewMessage;
    private bool previewIsError;

    private string currency =>
        accounts?.FirstOrDefault(a => a.Id.ToString() == sourceAccountId)?.Currency ?? "";

    private string destinationCurrency =>
        accounts?.FirstOrDefault(a => a.Id.ToString() == destinationAccountId)?.Currency ?? "";

    protected override async Task OnInitializedAsync()
    {
        await LoadAccountsAsync();
        await LoadCardTokensAsync();
    }

    private async Task UpdatePreviewAsync()
    {
        previewMessage = null;
        previewIsError = false;

        var sourceCurrencyValue = currency;
        var destinationCurrencyValue = destinationCurrency;

        if (string.IsNullOrEmpty(sourceCurrencyValue) || string.IsNullOrEmpty(destinationCurrencyValue))
            return;

        if (sourceCurrencyValue == destinationCurrencyValue)
            return;

        if (amount <= 0)
            return;

        try
        {
            var response = await Http.GetFromJsonAsync<ExchangeRateResponse>(
                $"/api/exchange-rate?from={sourceCurrencyValue}&to={destinationCurrencyValue}");

            var convertedAmount = Math.Round(amount * response!.Rate, 2, MidpointRounding.ToEven);
            previewMessage = $"You send {amount:0.00} {sourceCurrencyValue} → recipient receives approximately {convertedAmount:0.00} {destinationCurrencyValue} (rate: {response.Rate})";
        }
        catch (HttpRequestException)
        {
            previewIsError = true;
            previewMessage = "Exchange rate not available for this currency pair.";
        }
    }

    private async Task LoadAccountsAsync()
    {
        accounts = await Http.GetFromJsonAsync<AccountResponse[]>("/api/accounts");
    }

    private async Task LoadCardTokensAsync()
    {
        cardTokens = await Http.GetFromJsonAsync<CardTokenSummaryResponse[]>("/api/tokenize");
    }

    private async Task SubmitAsync()
    {
        resultMessage = null;

        if (!Guid.TryParse(sourceAccountId, out var sourceId) || !Guid.TryParse(destinationAccountId, out var destinationId))
        {
            resultIsSuccess = false;
            resultMessage = "Select both a source and destination account.";
            return;
        }

        Guid? cardTokenIdValue = Guid.TryParse(cardTokenId, out var parsedCardTokenId) ? parsedCardTokenId : null;

        isSubmitting = true;
        try
        {
            var request = new CreateTransactionRequest(
                sourceId,
                destinationId,
                amount,
                currency,
                Guid.NewGuid().ToString(),
                cardTokenIdValue);

            var response = await Http.PostAsJsonAsync("/api/transactions", request);

            if (response.IsSuccessStatusCode)
            {
                var transaction = await response.Content.ReadFromJsonAsync<TransactionResponse>();
                if (transaction!.Status == "Completed")
                {
                    await LoadAccountsAsync();
                    var updatedSource = accounts!.First(a => a.Id == sourceId);
                    var updatedDestination = accounts!.First(a => a.Id == destinationId);
                    resultIsSuccess = true;
                    resultMessage = $"Transaction completed. {updatedSource.Name} balance: {updatedSource.Currency} {updatedSource.Balance:0.00}. {updatedDestination.Name} balance: {updatedDestination.Currency} {updatedDestination.Balance:0.00}.";
                    if (transaction.CardTokenId is not null)
                    {
                        resultMessage += $" Authorized via card ending {transaction.CardTokenLastFourDigits}.";
                    }
                }
                else
                {
                    resultIsSuccess = false;
                    resultMessage = $"Transaction failed: {transaction.FailureReason}";
                }
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                resultIsSuccess = false;
                resultMessage = $"Request failed ({(int)response.StatusCode}): {body}";
            }
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
