@page "/"
@inject HttpClient Http
@inject AuthState Auth
@inject NavigationManager Navigation

<PageTitle>Send money</PageTitle>

<h1>Send money</h1>

@if (accounts is null)
{
    <p>Loading accounts...</p>
}
else if (accounts.Length == 0)
{
    <div class="panel">
        <div class="panel-heading">No accounts yet</div>
        <p class="list-empty">There is nothing to send from or to until an account exists.</p>
    </div>
}
else
{
    <div class="send-grid">
        <div class="panel send-form">
            @if (stage == SendStage.Form)
            {
            <div class="send-field">
                <label class="send-label" for="sourceCard">From</label>
                @if (cards is null || cards.Length == 0)
                {
                    <p class="list-empty mb-0">You need a card to send money. <a href="cards">Request a card</a>.</p>
                }
                else if (cards.Length == 1)
                {
                    <div class="send-value" id="sourceCard">@CardLabel(cards[0])</div>
                }
                else
                {
                    <select id="sourceCard" @bind="sourceCardId" class="form-select">
                        @foreach (var card in cards)
                        {
                            <option @key="card.Id" value="@card.Id">@CardLabel(card)</option>
                        }
                    </select>
                }
            </div>

            <div class="send-field">
                <label class="send-label" for="payeeCode">To</label>
                <div class="send-code-row">
                    <input id="payeeCode" type="text" inputmode="numeric" @bind="payeeCode" @bind:event="oninput" class="form-control send-code"
                           placeholder="Payment code" disabled="@(payee is not null)" @onkeydown="OnPayeeKeyDown" />
                    @if (payee is null)
                    {
                        <button id="payee-lookup" class="btn btn-secondary send-lookup" type="button" @onclick="LookUpPayeeAsync" disabled="@isLookingUp">
                            @(isLookingUp ? "Looking up..." : "Look up")
                        </button>
                    }
                    else
                    {
                        <button id="payee-clear" class="btn btn-secondary send-lookup" type="button" @onclick="ClearPayee">Change</button>
                    }
                </div>
                <div class="send-hint">Ask the person you are paying for a payment code. It works once and expires after 2 minutes.</div>
                @if (payee is null)
                {
                    <div class="send-hint">
                        No code to hand?
                        <button id="demo-shop" class="btn btn-secondary send-demo" type="button" @onclick="UseDemoShopAsync" disabled="@isLookingUp">Pay the demo shop</button>
                    </div>
                }
                @if (payeeError is not null)
                {
                    <div id="payee-error" class="alert alert-danger mt-2">@payeeError</div>
                }
            </div>

            <div class="send-field">
                <label class="send-label" for="amount">Amount</label>
                <div class="send-amount-row">
                    <span class="send-currency">@SourceCurrency</span>
                    <input id="amount" class="form-control send-amount" type="number" step="0.01" @bind="amount" />
                </div>
            </div>

            <div class="send-actions">
                <button class="btn btn-primary" @onclick="SubmitAsync" disabled="@isSubmitting">
                    @(isSubmitting ? "Sending..." : "Send money")
                </button>
                <button class="btn btn-secondary" type="button" @onclick="ClearAll">Clear</button>
            </div>
            }
            else if (stage == SendStage.SetPin)
            {
                <div class="send-step-title">Set your PIN</div>

                <div class="send-field">
                    <label class="send-label" for="new-pin">Choose a 6-digit PIN</label>
                    <input id="new-pin" type="text" inputmode="numeric" maxlength="6" autocomplete="off" @ref="newPinInput"
                           @bind="newPin" @bind:event="oninput" class="form-control send-pin" />
                </div>

                <div class="send-field">
                    <label class="send-label" for="repeat-pin">Repeat it</label>
                    <input id="repeat-pin" type="text" inputmode="numeric" maxlength="6" autocomplete="off"
                           @bind="repeatPin" @bind:event="oninput" class="form-control send-pin" @onkeydown="OnSetPinKeyDown" />
                    <div class="send-hint">You enter it to confirm every payment you send.</div>
                </div>

                if (pinError is not null)
                {
                    <div id="pin-error" class="alert alert-danger">@pinError</div>
                }

                <div class="send-actions">
                    <button id="pin-save" class="btn btn-primary" type="button" @onclick="SavePinAsync"
                            disabled="@(isSubmitting || newPin.Length != 6 || repeatPin.Length != 6)">
                        @(isSubmitting ? "Saving..." : "Save PIN")
                    </button>
                    <button class="btn btn-secondary" type="button" @onclick="CancelPayment">Cancel</button>
                </div>
            }
            else
            {
                <div class="send-step-title">Confirm payment</div>

                <div class="send-field">
                    <div class="send-label">Paying</div>
                    <div class="send-value">@(payee?.DisplayName ?? "the payee")</div>
                </div>

                <div class="send-field">
                    <div class="send-label">From</div>
                    <div class="send-value">@CardLabel(cards!.First(c => c.Id.ToString() == sourceCardId))</div>
                </div>

                <div class="send-field">
                    <div class="send-label">Amount</div>
                    <div class="send-confirm-amount">@SourceCurrency @amount.ToString("0.00")</div>
                </div>

                <div class="send-field">
                    <label class="send-label" for="confirm-pin">Your PIN</label>
                    <input id="confirm-pin" type="text" inputmode="numeric" maxlength="6" autocomplete="off" @ref="confirmPinInput"
                           @bind="confirmPin" @bind:event="oninput" class="form-control send-pin" @onkeydown="OnConfirmKeyDown" />
                    <div class="send-hint">This payment waits for your PIN for 5 minutes.</div>
                </div>

                if (pinError is not null)
                {
                    <div id="pin-error" class="alert alert-danger">@pinError</div>
                }

                <div class="send-actions">
                    <button id="pin-confirm" class="btn btn-primary" type="button" @onclick="ConfirmAsync"
                            disabled="@(isSubmitting || confirmPin.Length < 4)">
                        @(isSubmitting ? "Sending..." : "Confirm")
                    </button>
                    <button class="btn btn-secondary" type="button" @onclick="CancelPayment">Cancel</button>
                </div>
            }
        </div>

        <div class="panel send-result">
            @if (payee is not null)
            {
                <div id="payee-found">
                    <div class="send-label">Paying</div>
                    <div class="send-result-name">@payee.DisplayName</div>
                    <div class="send-hint">@payee.Currency &middot; @payee.BankName</div>
                </div>
            }
            @if (resultMessage is not null)
            {
                if (payee is not null)
                {
                    <div class="send-divider"></div>
                }
                <div class="@(resultIsSuccess ? "send-outcome-ok" : "send-outcome-fail")">@resultMessage</div>
                @if (lastTransactionId is not null)
                {
                    <div class="mt-3"><a href="flow/@lastTransactionId">See how Paysys processed this payment</a></div>
                }
            }
            else if (payee is null)
            {
                <p class="list-empty mb-0">Look up a payment code to see who you are paying.</p>
            }
        </div>
    </div>
}

@code {
    private AccountResponse[]? accounts;
    private CardTokenSummaryResponse[]? cards;
    private string sourceCardId = "";
    private string destinationAccountId = "";
    private decimal amount;
    private string? resultMessage;
    private Guid? lastTransactionId;
    private bool resultIsSuccess;
    private bool isSubmitting;

    // Sending money has three steps: the form, a one-time PIN setup for new users, and confirming
    // the pending payment with the PIN.
    private enum SendStage { Form, SetPin, Confirm }
    private SendStage stage = SendStage.Form;
    private bool pinSet;
    private string newPin = "";
    private string repeatPin = "";
    private string confirmPin = "";
    private string? pinError;
    private Guid pendingPaymentId;

    // The cursor goes into the PIN box as soon as it appears, once per step.
    private ElementReference newPinInput;
    private ElementReference confirmPinInput;
    private SendStage lastFocusedStage = SendStage.Form;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (stage == lastFocusedStage)
            return;

        lastFocusedStage = stage;

        if (stage == SendStage.SetPin)
            await newPinInput.FocusAsync();
        else if (stage == SendStage.Confirm)
            await confirmPinInput.FocusAsync();
    }

    private string payeeCode = "";
    private PayeeResponse? payee;
    private string? payeeError;
    private bool isLookingUp;

    private string CardLabel(CardTokenSummaryResponse card)
    {
        var account = accounts?.FirstOrDefault(a => a.Name == card.AccountName);
        var brand = CardBrandNames.Display(card.CardBrand);
        return $"{brand} ending {card.LastFourDigits} \u00b7 {card.AccountName}"
            + (account is null ? "" : $" \u00b7 {account.Currency} {account.Balance:0.00}");
    }

    private string SourceCurrency
    {
        get
        {
            var card = cards?.FirstOrDefault(c => c.Id.ToString() == sourceCardId);
            return accounts?.FirstOrDefault(a => a.Name == card?.AccountName)?.Currency ?? "";
        }
    }

    private void ClearAll()
    {
        ClearPayee();
        amount = 0;
        resultMessage = null;
        lastTransactionId = null;
    }

    private async Task OnPayeeKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && payee is null)
            await LookUpPayeeAsync();
    }

    private async Task LookUpPayeeAsync()
    {
        payeeError = null;
        isLookingUp = true;
        try
        {
            var response = await Http.GetAsync($"/api/payees/lookup?code={Uri.EscapeDataString(payeeCode)}");

            if (response.IsSuccessStatusCode)
            {
                payee = await response.Content.ReadFromJsonAsync<PayeeResponse>();
                destinationAccountId = payee!.AccountId.ToString();
                if (payee.RequiredAmount is { } requiredAmount)
                    amount = requiredAmount;
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                payeeError = "No payee found for that code. A payment code works once and expires after 2 minutes.";
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
            {
                payeeError = "That doesn't look like a code. Use a 6-digit payment code.";
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.TooManyRequests)
            {
                payeeError = "Too many lookups that didn't match. Wait a moment and try again.";
            }
            else
            {
                payeeError = $"Lookup failed ({(int)response.StatusCode}).";
            }
        }
        finally
        {
            isLookingUp = false;
        }
    }

    // Public demo: gets a fresh code for the built-in shop and looks it up at once, so the person
    // can try a whole payment with one account.
    private async Task UseDemoShopAsync()
    {
        payeeError = null;
        isLookingUp = true;
        try
        {
            var response = await Http.PostAsync("/api/demo/shop-code", null);
            if (!response.IsSuccessStatusCode)
            {
                payeeError = await ApiErrors.ReadAsync(response);
                return;
            }

            var issued = await response.Content.ReadFromJsonAsync<PaymentCodeResponse>();
            payeeCode = issued!.Code;
        }
        finally
        {
            isLookingUp = false;
        }

        await LookUpPayeeAsync();
    }

    private void ClearPayee()
    {
        payee = null;
        payeeCode = "";
        payeeError = null;
        destinationAccountId = "";
    }

    protected override async Task OnInitializedAsync()
    {
        // Merchants and banks have their own start page.
        if (Auth.IsMerchant)
        {
            Navigation.NavigateTo("collect", replace: true);
            return;
        }

        if (Auth.IsBank)
        {
            Navigation.NavigateTo("bank", replace: true);
            return;
        }

        await LoadAccountsAsync();
        await LoadPinStatusAsync();
    }

    private async Task LoadAccountsAsync()
    {
        accounts = await Http.GetFromJsonAsync<AccountResponse[]>("/api/accounts");
        cards = await Http.GetFromJsonAsync<CardTokenSummaryResponse[]>("/api/tokenize");
        if (string.IsNullOrEmpty(sourceCardId) && cards is { Length: > 0 })
            sourceCardId = cards[0].Id.ToString();
    }

    private async Task LoadPinStatusAsync()
    {
        var status = await Http.GetFromJsonAsync<PinStatusResponse>("/api/pin");
        pinSet = status?.IsSet ?? false;
    }

    private async Task OnSetPinKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && newPin.Length == 6 && repeatPin.Length == 6)
            await SavePinAsync();
    }

    private async Task OnConfirmKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && confirmPin.Length >= 4)
            await ConfirmAsync();
    }

    private void CancelPayment()
    {
        stage = SendStage.Form;
        newPin = "";
        repeatPin = "";
        confirmPin = "";
        pinError = null;
    }

    // Step one: check the form, then (first time only) set a PIN, then park the payment on the server.
    private async Task SubmitAsync()
    {
        resultMessage = null;
        lastTransactionId = null;
        pinError = null;

        if (!Guid.TryParse(sourceCardId, out _) || !Guid.TryParse(destinationAccountId, out _))
        {
            resultIsSuccess = false;
            resultMessage = "Choose a card and look up a payment code first.";
            return;
        }

        if (!pinSet)
        {
            newPin = "";
            repeatPin = "";
            stage = SendStage.SetPin;
            return;
        }

        await CreatePendingAsync();
    }

    private async Task SavePinAsync()
    {
        pinError = null;

        if (newPin.Length != 6 || !newPin.All(char.IsAsciiDigit))
        {
            pinError = "The PIN must be exactly 6 digits.";
            return;
        }

        if (newPin != repeatPin)
        {
            pinError = "The two PINs do not match.";
            return;
        }

        isSubmitting = true;
        try
        {
            var response = await Http.PostAsJsonAsync("/api/pin", new SetPinRequest(newPin));
            if (!response.IsSuccessStatusCode)
            {
                pinError = await ApiErrors.ReadAsync(response);
                return;
            }

            pinSet = true;
            newPin = "";
            repeatPin = "";
        }
        finally
        {
            isSubmitting = false;
        }

        await CreatePendingAsync();
    }

    private async Task CreatePendingAsync()
    {
        if (!Guid.TryParse(sourceCardId, out var cardId) || !Guid.TryParse(destinationAccountId, out var destinationId))
        {
            stage = SendStage.Form;
            return;
        }

        isSubmitting = true;
        try
        {
            var request = new CreateTransactionRequest(
                null,
                destinationId,
                amount,
                Guid.NewGuid().ToString(),
                cardId);

            var response = await Http.PostAsJsonAsync("/api/payments", request);

            if (response.IsSuccessStatusCode)
            {
                var pending = await response.Content.ReadFromJsonAsync<PendingPaymentResponse>();
                pendingPaymentId = pending!.PaymentId;
                confirmPin = "";
                pinError = null;
                stage = SendStage.Confirm;
            }
            else
            {
                resultIsSuccess = false;
                resultMessage = await ApiErrors.ReadAsync(response);
                stage = SendStage.Form;
            }
        }
        finally
        {
            isSubmitting = false;
        }
    }

    // Step two: the PIN confirms the pending payment and the server runs it.
    private async Task ConfirmAsync()
    {
        pinError = null;
        isSubmitting = true;
        try
        {
            var response = await Http.PostAsJsonAsync($"/api/payments/{pendingPaymentId}/confirm", new ConfirmPaymentRequest(confirmPin));

            if (response.IsSuccessStatusCode)
            {
                var transaction = await response.Content.ReadFromJsonAsync<TransactionResponse>();
                lastTransactionId = transaction?.Id;
                stage = SendStage.Form;
                confirmPin = "";

                if (transaction!.Status == "Completed")
                {
                    await LoadAccountsAsync();
                    var updatedSource = accounts!.First(a => a.Id == transaction.SourceAccountId);

                    resultIsSuccess = true;
                    resultMessage = $"Sent {amount:0.00} to {payee?.DisplayName ?? "the payee"}. {updatedSource.Name} balance: {updatedSource.Currency} {updatedSource.Balance:0.00}.";
                    ClearPayee();
                    if (transaction.CardTokenId is not null)
                    {
                        resultMessage += $" Authorized via card ending {transaction.CardTokenLastFourDigits}.";
                    }
                }
                else
                {
                    resultIsSuccess = false;
                    resultMessage = $"Transaction failed: {transaction.FailureReason}";
                }

                return;
            }

            var message = await ApiErrors.ReadAsync(response);
            confirmPin = "";

            // A wrong PIN keeps the payment waiting; anything else (cancelled after three wrong
            // PINs, expired, locked, a failed payment) sends the person back to the form.
            if (response.StatusCode == System.Net.HttpStatusCode.Forbidden && !message.Contains("cancelled"))
            {
                pinError = message;
            }
            else
            {
                resultIsSuccess = false;
                resultMessage = message;
                stage = SendStage.Form;
            }
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
