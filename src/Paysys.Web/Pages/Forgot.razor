@page "/forgot"

<PageTitle>Forgot password</PageTitle>

<div class="auth-swipe auth-swipe-right">
    <h1>Forgot password</h1>
    <p>
        Paysys has no email address for your account, so a reset link can't be sent.
        Ask the Paysys operator to set a new password for you, then sign in with it.
    </p>
    <a href="login">Back to log in</a>
</div>
