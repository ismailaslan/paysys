@page "/history"
@inject HttpClient Http

<PageTitle>Transaction History</PageTitle>

<h1>Transaction History</h1>

@if (accounts is null)
{
    <p>Loading accounts...</p>
}
else
{
    <div class="mb-3">
        <label for="account">Account</label>
        <select id="account" @bind="selectedAccountId" @bind:after="LoadTransactionsAsync" class="form-select">
            <option value="">-- select --</option>
            @foreach (var account in accounts)
            {
                <option @key="account.Id" value="@account.Id">@account.Name (@account.AccountType, @account.Currency @account.Balance.ToString("0.00"))</option>
            }
        </select>
    </div>

    @if (string.IsNullOrEmpty(selectedAccountId))
    {
        <p>Select an account to view its transaction history.</p>
    }
    else if (isLoading)
    {
        <p>Loading transactions...</p>
    }
    else if (transactions is not null && transactions.Length == 0)
    {
        <p>No transactions found for this account.</p>
    }
    else if (transactions is not null)
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Amount</th>
                    <th>Currency</th>
                    <th>Status</th>
                    <th>Source</th>
                    <th>Destination</th>
                    <th>Created</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var transaction in transactions)
                {
                    <tr>
                        <td>@transaction.Amount.ToString("0.00")</td>
                        <td>@transaction.Currency</td>
                        <td>@transaction.Status</td>
                        <td>@AccountName(transaction.SourceAccountId)</td>
                        <td>@AccountName(transaction.DestinationAccountId)</td>
                        <td>@transaction.CreatedAt.ToLocalTime().ToString("g")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private AccountResponse[]? accounts;
    private TransactionResponse[]? transactions;
    private string selectedAccountId = "";
    private bool isLoading;

    protected override async Task OnInitializedAsync()
    {
        accounts = await Http.GetFromJsonAsync<AccountResponse[]>("/api/accounts");
    }

    private string AccountName(Guid accountId) =>
        accounts?.FirstOrDefault(a => a.Id == accountId)?.Name ?? accountId.ToString();

    private async Task LoadTransactionsAsync()
    {
        if (!Guid.TryParse(selectedAccountId, out var accountId))
        {
            transactions = null;
            return;
        }

        isLoading = true;
        transactions = null;
        try
        {
            transactions = await Http.GetFromJsonAsync<TransactionResponse[]>($"/api/transactions/{accountId}");
        }
        finally
        {
            isLoading = false;
        }
    }
}
