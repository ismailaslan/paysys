@page "/accounts"
@using System.Text.Json
@using Paysys.Shared.Banks
@inject HttpClient Http

<PageTitle>Accounts</PageTitle>

<h1>Accounts</h1>

<div class="split-layout">
    <div class="list-panel panel">
        <div class="panel-heading">Existing Accounts</div>
        @if (accounts is null)
        {
            <p class="list-empty">Loading...</p>
        }
        else if (accounts.Length == 0)
        {
            <p class="list-empty">No accounts yet.</p>
        }
        else
        {
            <div class="list-items">
                @foreach (var account in accounts)
                {
                    <div class="list-item" @key="account.Id">
                        <div class="list-item-title">@account.Name</div>
                        <div class="list-item-subtitle">
                            @account.BankName &middot; @account.ClientType &middot; @account.Currency @account.Balance.ToString("0.00")
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <div class="form-panel panel">
        <div class="panel-heading">Create an Account</div>

        @if (createdAccount is not null)
        {
            <div class="alert alert-success">
                <p><strong>Account created.</strong></p>
                <p>
                    Id: @createdAccount.Id<br />
                    Name: @createdAccount.Name<br />
                    Balance: @createdAccount.Currency @createdAccount.Balance.ToString("0.00")<br />
                    Account type: @createdAccount.AccountType<br />
                    Bank: @createdAccount.BankName<br />
                    Client type: @createdAccount.ClientType<br />
                    @if (createdAccount.TerminalId is not null)
                    {
                        <text>Terminal Id: @createdAccount.TerminalId<br /></text>
                    }
                    Created: @createdAccount.CreatedAt.ToLocalTime().ToString("g")
                </p>
            </div>

            <button class="btn btn-primary" @onclick="ResetForm">Create another</button>
        }
        else if (currencies is null || banks is null)
        {
            <p class="list-empty">Loading...</p>
        }
        else
        {
            <div class="mb-3">
                <label for="name">Name</label>
                <input id="name" type="text" @bind="name" class="form-control" />
            </div>

            <div class="mb-3">
                <label for="balance">Balance</label>
                <input id="balance" type="number" step="0.01" @bind="balance" class="form-control" />
            </div>

            <div class="mb-3">
                <label for="currency">Currency</label>
                <select id="currency" @bind="currency" class="form-select">
                    <option value="">-- select --</option>
                    @foreach (var currencyCode in currencies)
                    {
                        <option @key="currencyCode" value="@currencyCode">@currencyCode</option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label for="accountType">Account type</label>
                <select id="accountType" @bind="accountType" class="form-select">
                    <option value="Person">Person</option>
                    <option value="Bank">Bank</option>
                </select>
            </div>

            <div class="mb-3">
                <label for="bank">Bank</label>
                <select id="bank" @bind="bankId" class="form-select">
                    <option value="">-- select --</option>
                    @foreach (var bank in banks)
                    {
                        <option @key="bank.Id" value="@bank.Id">@bank.Name (@bank.BankCode)</option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label for="clientType">Client type</label>
                <select id="clientType" @bind="clientType" @bind:after="ClientTypeChanged" class="form-select">
                    <option value="Individual">Individual</option>
                    <option value="Business">Business</option>
                </select>
            </div>

            @if (clientType == "Business")
            {
                <div class="mb-3">
                    <label for="terminalId">Terminal Id</label>
                    <input id="terminalId" type="text" @bind="terminalId" class="form-control" />
                </div>
            }

            <button class="btn btn-primary" @onclick="SubmitAsync" disabled="@isSubmitting">
                @(isSubmitting ? "Submitting..." : "Submit")
            </button>

            @if (errorMessage is not null)
            {
                <div class="alert alert-danger mt-3">
                    @errorMessage
                </div>
            }
        }
    </div>
</div>

@code {
    private AccountResponse[]? accounts;
    private string[]? currencies;
    private BankResponse[]? banks;

    private string name = "";
    private decimal balance;
    private string currency = "";
    private string accountType = "Person";
    private string bankId = "";
    private string clientType = "Individual";
    private string terminalId = "";
    private bool isSubmitting;
    private string? errorMessage;
    private AccountResponse? createdAccount;

    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web);

    protected override async Task OnInitializedAsync()
    {
        await LoadAccountsAsync();
        currencies = await Http.GetFromJsonAsync<string[]>("/api/currencies");
        banks = await Http.GetFromJsonAsync<BankResponse[]>("/api/banks");
    }

    private async Task LoadAccountsAsync()
    {
        accounts = await Http.GetFromJsonAsync<AccountResponse[]>("/api/accounts");
    }

    private void ClientTypeChanged()
    {
        // Clear a stale TerminalId when switching back to Individual, so it
        // can't accidentally get submitted and trip the domain guard that
        // rejects a TerminalId on an Individual account.
        if (clientType != "Business")
        {
            terminalId = "";
        }
    }

    private async Task SubmitAsync()
    {
        errorMessage = null;

        if (!int.TryParse(bankId, out var parsedBankId))
        {
            errorMessage = "Select a bank.";
            return;
        }

        isSubmitting = true;
        try
        {
            var request = new CreateAccountRequest(
                name, balance, currency, accountType, parsedBankId, clientType,
                clientType == "Business" ? terminalId : null);

            var response = await Http.PostAsJsonAsync("/api/accounts", request);

            if (response.IsSuccessStatusCode)
            {
                createdAccount = await response.Content.ReadFromJsonAsync<AccountResponse>();
                await LoadAccountsAsync();
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
            {
                var problem = await response.Content.ReadFromJsonAsync<ValidationProblemResponse>(JsonOptions);
                var messages = problem?.Errors?.SelectMany(kvp => kvp.Value) ?? [];
                errorMessage = messages.Any()
                    ? string.Join(" ", messages)
                    : await response.Content.ReadAsStringAsync();
            }
            else
            {
                errorMessage = $"Request failed ({(int)response.StatusCode}): {await response.Content.ReadAsStringAsync()}";
            }
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void ResetForm()
    {
        createdAccount = null;
        name = "";
        balance = 0;
        currency = "";
        accountType = "Person";
        bankId = "";
        clientType = "Individual";
        terminalId = "";
        errorMessage = null;
    }

    private record ValidationProblemResponse(Dictionary<string, string[]>? Errors);
}
