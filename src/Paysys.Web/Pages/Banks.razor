@page "/banks"
@using System.Text.Json
@using Paysys.Shared.Banks
@using Paysys.Shared.Accounts
@inject HttpClient Http
@inject AuthState Auth

<PageTitle>Banks</PageTitle>

<h1>Banks</h1>

@if (!Auth.IsAdmin)
{
    <ConnectBank />
}
else
{
<div class="split-layout">
    <div class="list-panel panel">
        <div class="panel-heading">Existing Banks</div>
        @if (banks is null)
        {
            <p class="list-empty">Loading...</p>
        }
        else if (banks.Length == 0)
        {
            <p class="list-empty">No banks yet.</p>
        }
        else
        {
            <div class="list-items">
                @foreach (var bank in banks)
                {
                    <div class="list-item" @key="bank.Id">
                        <div class="list-item-title">@bank.Name</div>
                        <div class="list-item-subtitle">
                            Code: @bank.BankCode
                            @if (!string.IsNullOrWhiteSpace(bank.ApiEndpoint))
                            {
                                <text> &middot; @bank.ApiEndpoint</text>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <div class="form-panel panel">
        <div class="panel-heading">Add a Bank</div>

        @if (createdBank is not null)
        {
            <div class="alert alert-success">
                <p><strong>Bank created.</strong></p>
                <p>
                    Id: @createdBank.Id<br />
                    Name: @createdBank.Name<br />
                    Code: @createdBank.BankCode<br />
                    ApiEndpoint: @(createdBank.ApiEndpoint ?? "(none)")
                </p>
            </div>

            <button class="btn btn-primary" @onclick="ResetForm">Add another</button>
        }
        else
        {
            <div class="mb-3">
                <label for="name">Name</label>
                <input id="name" type="text" @bind="name" class="form-control" />
            </div>

            <div class="mb-3">
                <label for="bankCode">Bank code</label>
                <input id="bankCode" type="text" @bind="bankCode" class="form-control" />
            </div>

            <div class="mb-3">
                <label for="apiEndpoint">API endpoint (optional)</label>
                <input id="apiEndpoint" type="text" @bind="apiEndpoint" class="form-control" placeholder="http://..." />
            </div>

            <button class="btn btn-primary" @onclick="SubmitAsync" disabled="@isSubmitting">
                @(isSubmitting ? "Submitting..." : "Submit")
            </button>

            @if (errorMessage is not null)
            {
                <div class="alert alert-danger mt-3">
                    @errorMessage
                </div>
            }
        }
    </div>
</div>

<div class="panel mt-4">
    <div class="panel-heading">Create a bank login</div>
    @if (banks is null || banks.Length == 0)
    {
        <p class="list-empty">Add a bank first.</p>
    }
    else
    {
        <div class="mb-3">
            <label for="loginBank">Bank</label>
            <select id="loginBank" @bind="loginBankId" class="form-select">
                <option value="">-- select --</option>
                @foreach (var bank in banks)
                {
                    <option @key="bank.Id" value="@bank.Id">@bank.Name</option>
                }
            </select>
        </div>
        <div class="mb-3">
            <label for="loginUsername">Username</label>
            <input id="loginUsername" type="text" @bind="loginUsername" autocomplete="off" class="form-control" />
        </div>
        <div class="mb-3">
            <label for="loginPassword">Password</label>
            <input id="loginPassword" type="password" @bind="loginPassword" autocomplete="new-password" class="form-control" />
        </div>
        <button class="btn btn-primary" @onclick="CreateBankLoginAsync" disabled="@isCreatingLogin">
            @(isCreatingLogin ? "Creating..." : "Create login")
        </button>
        @if (loginMessage is not null)
        {
            <div class="alert @(loginFailed ? "alert-danger" : "alert-success") mt-3">@loginMessage</div>
        }
    }
</div>
}

@code {
    private BankResponse[]? banks;
    private string name = "";
    private string bankCode = "";
    private string apiEndpoint = "";
    private bool isSubmitting;
    private string? errorMessage;
    private BankResponse? createdBank;


    protected override async Task OnInitializedAsync()
    {
        await LoadBanksAsync();
    }

    private async Task LoadBanksAsync()
    {
        banks = await Http.GetFromJsonAsync<BankResponse[]>("/api/banks");
    }

    private string loginBankId = "";
    private string loginUsername = "";
    private string loginPassword = "";
    private bool isCreatingLogin;
    private bool loginFailed;
    private string? loginMessage;

    // Admin: creates a login for a bank, tied to that bank.
    private async Task CreateBankLoginAsync()
    {
        loginMessage = null;
        if (!int.TryParse(loginBankId, out var bankId))
        {
            loginFailed = true;
            loginMessage = "Select a bank.";
            return;
        }

        isCreatingLogin = true;
        try
        {
            var response = await Http.PostAsJsonAsync($"/api/banks/{bankId}/login", new CreateBankLoginRequest(loginUsername, loginPassword));
            loginFailed = !response.IsSuccessStatusCode;
            loginMessage = response.IsSuccessStatusCode
                ? $"Login '{loginUsername}' created. It can sign in now."
                : await ApiErrors.ReadAsync(response);
            if (response.IsSuccessStatusCode)
            {
                loginUsername = "";
                loginPassword = "";
            }
        }
        finally
        {
            isCreatingLogin = false;
        }
    }
    private async Task SubmitAsync()
    {
        errorMessage = null;
        isSubmitting = true;
        try
        {
            var request = new CreateBankRequest(name, bankCode, string.IsNullOrWhiteSpace(apiEndpoint) ? null : apiEndpoint);
            var response = await Http.PostAsJsonAsync("/api/banks", request);

            if (response.IsSuccessStatusCode)
            {
                createdBank = await response.Content.ReadFromJsonAsync<BankResponse>();
                await LoadBanksAsync();
            }
            else
            {
                errorMessage = await ApiErrors.ReadAsync(response);
            }
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void ResetForm()
    {
        createdBank = null;
        name = "";
        bankCode = "";
        apiEndpoint = "";
        errorMessage = null;
    }

}
