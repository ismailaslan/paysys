@page "/banks"
@using System.Text.Json
@using Paysys.Shared.Banks
@using Paysys.Shared.Accounts
@inject HttpClient Http
@inject AuthState Auth

<PageTitle>Banks</PageTitle>

<h1>Banks</h1>

@if (!Auth.IsAdmin)
{
    <div class="panel">
        <div class="panel-heading">Connect a bank</div>
        @if (banks is null || myAccounts is null)
        {
            <p class="list-empty">Loading...</p>
        }
        else if (banks.Length == 0)
        {
            <p class="list-empty">No banks available yet.</p>
        }
        else
        {
            <div class="list-items">
                @foreach (var bank in banks)
                {
                    <div class="list-item" @key="bank.Id">
                        <div class="list-item-title">@bank.Name</div>
                        <div class="list-item-subtitle">Code: @bank.BankCode</div>
                        <div class="mt-2">
                            @if (myAccounts.Any(a => a.IsMine && a.BankId == bank.Id))
                            {
                                @if (confirmDisconnectBankId == bank.Id)
                                {
                                    <span class="small">Disconnect and remove this account?</span>
                                    <button class="btn btn-primary btn-sm ms-2" type="button" @onclick="() => DisconnectAsync(bank.Id)" disabled="@isConnecting">Yes, disconnect</button>
                                    <button class="btn btn-secondary btn-sm ms-1" type="button" @onclick="() => confirmDisconnectBankId = null">Cancel</button>
                                }
                                else
                                {
                                    <span class="text-muted small">Connected</span>
                                    <button class="btn btn-secondary btn-sm ms-2" type="button" @onclick="() => confirmDisconnectBankId = bank.Id">Disconnect</button>
                                }
                            }
                            else
                            {
                                <button class="btn btn-primary btn-sm" type="button" @onclick="() => ConnectAsync(bank.Id)" disabled="@isConnecting">Connect</button>
                            }
                        </div>
                    </div>
                }
            </div>
        }

        @if (connectMessage is not null)
        {
            <div class="alert @(connectFailed ? "alert-danger" : "alert-success") mt-3">@connectMessage</div>
        }
    </div>
}
else
{
<div class="split-layout">
    <div class="list-panel panel">
        <div class="panel-heading">Existing Banks</div>
        @if (banks is null)
        {
            <p class="list-empty">Loading...</p>
        }
        else if (banks.Length == 0)
        {
            <p class="list-empty">No banks yet.</p>
        }
        else
        {
            <div class="list-items">
                @foreach (var bank in banks)
                {
                    <div class="list-item" @key="bank.Id">
                        <div class="list-item-title">@bank.Name</div>
                        <div class="list-item-subtitle">
                            Code: @bank.BankCode
                            @if (!string.IsNullOrWhiteSpace(bank.ApiEndpoint))
                            {
                                <text> &middot; @bank.ApiEndpoint</text>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <div class="form-panel panel">
        <div class="panel-heading">Add a Bank</div>

        @if (createdBank is not null)
        {
            <div class="alert alert-success">
                <p><strong>Bank created.</strong></p>
                <p>
                    Id: @createdBank.Id<br />
                    Name: @createdBank.Name<br />
                    Code: @createdBank.BankCode<br />
                    ApiEndpoint: @(createdBank.ApiEndpoint ?? "(none)")
                </p>
            </div>

            <button class="btn btn-primary" @onclick="ResetForm">Add another</button>
        }
        else
        {
            <div class="mb-3">
                <label for="name">Name</label>
                <input id="name" type="text" @bind="name" class="form-control" />
            </div>

            <div class="mb-3">
                <label for="bankCode">Bank code</label>
                <input id="bankCode" type="text" @bind="bankCode" class="form-control" />
            </div>

            <div class="mb-3">
                <label for="apiEndpoint">API endpoint (optional)</label>
                <input id="apiEndpoint" type="text" @bind="apiEndpoint" class="form-control" placeholder="http://..." />
            </div>

            <button class="btn btn-primary" @onclick="SubmitAsync" disabled="@isSubmitting">
                @(isSubmitting ? "Submitting..." : "Submit")
            </button>

            @if (errorMessage is not null)
            {
                <div class="alert alert-danger mt-3">
                    @errorMessage
                </div>
            }
        }
    </div>
</div>
}

@code {
    private BankResponse[]? banks;
    private string name = "";
    private string bankCode = "";
    private string apiEndpoint = "";
    private bool isSubmitting;
    private string? errorMessage;
    private BankResponse? createdBank;


    protected override async Task OnInitializedAsync()
    {
        await LoadBanksAsync();
    }

    private async Task LoadBanksAsync()
    {
        banks = await Http.GetFromJsonAsync<BankResponse[]>("/api/banks");
        if (!Auth.IsAdmin)
            myAccounts = await Http.GetFromJsonAsync<AccountResponse[]>("/api/accounts");
    }

    private AccountResponse[]? myAccounts;
    private int? confirmDisconnectBankId;
    private bool isConnecting;
    private bool connectFailed;
    private string? connectMessage;

    // Removes the signed-in user's account at the chosen bank, if it is empty and unused.
    private async Task DisconnectAsync(int bankId)
    {
        connectMessage = null;
        isConnecting = true;
        try
        {
            var response = await Http.DeleteAsync($"/api/banks/{bankId}/connect");
            connectFailed = !response.IsSuccessStatusCode;
            connectMessage = response.IsSuccessStatusCode
                ? "Disconnected."
                : await ApiErrors.ReadAsync(response);
            confirmDisconnectBankId = null;
            if (response.IsSuccessStatusCode)
                await LoadBanksAsync();
        }
        finally
        {
            isConnecting = false;
        }
    }

    // Opens an empty account for the signed-in user at the chosen bank.
    private async Task ConnectAsync(int bankId)
    {
        connectMessage = null;
        isConnecting = true;
        try
        {
            var response = await Http.PostAsync($"/api/banks/{bankId}/connect", null);
            connectFailed = !response.IsSuccessStatusCode;
            connectMessage = response.IsSuccessStatusCode
                ? "Connected. Your new account is under Accounts."
                : await ApiErrors.ReadAsync(response);
            if (response.IsSuccessStatusCode)
                await LoadBanksAsync();
        }
        finally
        {
            isConnecting = false;
        }
    }

    private async Task SubmitAsync()
    {
        errorMessage = null;
        isSubmitting = true;
        try
        {
            var request = new CreateBankRequest(name, bankCode, string.IsNullOrWhiteSpace(apiEndpoint) ? null : apiEndpoint);
            var response = await Http.PostAsJsonAsync("/api/banks", request);

            if (response.IsSuccessStatusCode)
            {
                createdBank = await response.Content.ReadFromJsonAsync<BankResponse>();
                await LoadBanksAsync();
            }
            else
            {
                errorMessage = await ApiErrors.ReadAsync(response);
            }
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void ResetForm()
    {
        createdBank = null;
        name = "";
        bankCode = "";
        apiEndpoint = "";
        errorMessage = null;
    }

}
